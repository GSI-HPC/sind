{{define "page-cluster"}}
<div class="crumbs"><a href="/clusters">Clusters</a> / <a href="/clusters?realm={{.Params.Get "realm"}}">{{.Params.Get "realm"}}</a> / {{.Params.Get "cluster"}}</div>
<div hx-swap="morph:innerHTML" sse-swap="pg-cluster-head">{{fragment "pg-cluster-head" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="pg-cluster-body">{{fragment "pg-cluster-body" .}}</div>
{{end}}

{{define "pg-cluster-head"}}{{with .Data}}{{if not .Found}}{{template "pg-gone" .Name}}{{else}}
<div class="head"><div class="t"><h1>{{.Name}} <span class="pill {{.Cluster.StateClass}}" data-say="{{.Name}} is {{.Cluster.State}}.">{{.Cluster.State}}</span></h1>
  <div class="sub">{{with .Cluster.Slurm}}<span class="mono">Slurm {{.}}</span>{{end}}<span>{{with .Cluster.Roles}}{{.}}{{else}}no nodes{{end}}</span>{{if .Cluster.Monitoring}}<span class="chip brand">monitoring</span>{{end}}</div></div>
  <div class="actions">{{range .Actions}}{{template "pg-action" .}}{{end}}</div></div>
{{with .Cluster.Banner}}<div class="callout run pg-run"><span class="pg-spin"></span><span class="pg-grow">{{if .Command}}<b class="mono">{{.Command}}</b>{{else}}<b>{{.Count}}</b>{{end}} {{.Text}}</span><a class="btn sm" href="{{.Href}}">Show progress</a></div>{{end}}
<div class="tabs">{{range .Tabs}}<a class="tab{{if .On}} on{{end}}" href="{{.URL}}"{{if .On}} aria-current="page"{{end}}>{{.Label}}{{if .Count}}<span class="n{{if .Bad}} bad{{end}}">{{.Count}}</span>{{end}}</a>{{end}}</div>
{{end}}{{end}}{{template "pg-docker-note" .}}{{end}}

{{define "pg-cluster-body"}}{{with .Data}}{{if .Found}}
{{if eq .Tab "summary"}}{{template "pg-tab-summary" .}}
{{else if eq .Tab "nodes"}}{{template "pg-tab-nodes" .}}
{{else if eq .Tab "logs"}}{{template "logs-tab" $}}
{{else if eq .Tab "network"}}{{template "pg-tab-network" .}}
{{else}}{{template "pg-tab-connect" .}}{{end}}
{{end}}{{end}}{{end}}

{{define "pg-tab-summary"}}<div class="grid g2">
<section class="panel pg-wide"><div class="ph"><h2>Nodes</h2><span class="grow"></span><span class="faint">{{.NodesText}}</span></div><div class="pb">
  <div class="pg-nodemap pg-big">{{range .Cluster.Nodes}}<a class="{{.Tile}}" href="{{.Link}}" title="{{.Short}} · {{.Role}} · {{.State}}" aria-label="{{.Arg}}, {{.State}}"></a>{{else}}<span class="muted">This cluster has no node.</span>{{end}}</div>
  <p class="hint pg-hint">The controller is the dark teal tile with three lines. Other service nodes are teal, workers sky blue. A red outline is a node that does not run, hatching a paused one, an amber ring a node with a service down.</p></div></section>
<section class="panel pg-wide"><div class="ph"><h2>Health</h2><span class="grow"></span><span class="faint mono">sind get cluster{{.ClusterArg}}</span></div>
  {{if not .Status}}<div class="pb"><div class="callout">Service health appears once sind ui has probed the cluster.</div></div>{{end}}
  <div class="tw"><table class="pg-mx"><thead><tr><th>Node</th><th>State</th>{{range .Services}}<th class="mono pg-svc"><span data-word="{{.}}">{{.}}</span></th>{{end}}</tr></thead><tbody>
  {{range .Matrix}}<tr class="click" data-href="{{.Node.Link}}"><td class="mono"><a href="{{.Node.Link}}"><b>{{.Node.Short}}</b></a></td><td><span class="pill {{.Node.StateClass}}">{{.Node.State}}</span></td>{{range .Cells}}<td><span class="pg-ck {{.Class}}">{{.Mark}}</span></td>{{end}}</tr>
  {{end}}</tbody></table></div></section>
<section class="panel"><div class="ph"><h2>Cluster</h2></div><div class="pb"><dl class="kv">
  <dt><span data-word="realm">realm</span></dt><dd class="mono">{{.Realm}}</dd>
  <dt>state</dt><dd><span class="pill {{.Cluster.StateClass}}">{{.Cluster.State}}</span></dd>
  {{with .Cluster.Slurm}}<dt>Slurm</dt><dd class="mono">{{.}}</dd>{{end}}
  {{with .Data}}<dt><span data-word="data">data</span></dt><dd class="mono">{{.Source}} <span class="faint">({{if eq (print .Type) "volume"}}volume{{else}}host directory{{end}}) → {{.Path}}</span></dd>{{end}}
  {{with .HA}}<dt><span data-word="controller-backup">controllers</span></dt><dd>{{range .}}<span class="chip">{{.}}</span>{{end}}</dd>{{end}}</dl></div></section>
<section class="panel"><div class="ph"><h2>Network</h2></div><div class="pb">
  {{with .Status}}{{with .Network}}<dl class="kv">
  <dt>cluster network</dt><dd class="mono">{{.ClusterName}} {{template "pg-ok" .Cluster}}</dd><dt>subnet</dt><dd class="mono">{{.ClusterSubnet}}</dd>
  <dt><span data-word="mesh">mesh</span></dt><dd class="mono">{{.MeshName}} {{template "pg-ok" .Mesh}}</dd><dt>DNS</dt><dd>{{template "pg-ok" .DNS}}</dd><dt>SSH relay</dt><dd>{{template "pg-ok" .SSH}}</dd>
  {{if $.Cluster.Monitoring}}<dt>monitoring</dt><dd>grafana, prometheus, loki, alloy</dd>{{end}}</dl>{{else}}<span class="muted">No network data.</span>{{end}}
  {{else}}<span class="muted">Network health appears once sind ui has probed the cluster.</span>{{end}}</div></section>
</div>{{end}}

{{define "pg-tab-nodes"}}<section class="panel" data-pg-nodes>
  <div class="pg-selbar" data-pg-selbar hidden><span>Selection: <span class="pg-expr" data-pg-expr></span></span><span class="pg-grow"></span>
    {{range .Selection}}<a class="btn sm" href="{{.URL}}" data-pg-dialog>{{.Label}}</a>{{end}}{{range .WorkerSelection}}<a class="btn sm" href="{{.URL}}" data-pg-dialog data-pg-workers>{{.Label}}</a>{{end}}<a class="btn sm danger" href="{{.Delete.URL}}" data-pg-dialog data-pg-workers data-pg-delete>{{.Delete.Label}}</a><button type="button" class="btn sm ghost" data-pg-clear>Clear</button></div>
  <div class="tw"><table><thead><tr><th class="pg-chk"><input type="checkbox" data-pg-all aria-label="Select all"></th><th>Node</th><th>Role</th><th>State</th><th>IP</th><th>Services</th></tr></thead><tbody>
  {{range .Cluster.Nodes}}<tr data-pg-node="{{.Short}}" data-pg-role="{{.Role}}"><td><input type="checkbox" data-pg-sel="{{.Short}}" aria-label="Select {{.Short}}"></td>
    <td class="mono"><a href="{{.Link}}"><b>{{.Short}}</b></a></td><td><span class="chip {{.RoleClass}}" data-word="{{.Role}}">{{.Role}}</span></td><td><span class="pill {{.StateClass}}" data-say="{{.Short}} is {{.State}}." data-say-key="{{.Short}}">{{.State}}</span></td><td class="mono">{{.IP}}</td>
    <td>{{range .Issues}}<span class="pill {{.Class}}">{{.Text}}</span> {{else}}{{if .Known}}<span class="faint">{{.ServiceUp}} up</span>{{else}}<span class="faint">–</span>{{end}}{{end}}</td></tr>
  {{else}}<tr><td colspan="6"><div class="empty">This cluster has no node.</div></td></tr>{{end}}
  </tbody></table></div></section>
<p class="muted pg-hint">Pick nodes to act on them. The selection stays when the table updates.</p>{{end}}

{{define "pg-tab-network"}}<div class="grid g2"><section class="panel"><div class="ph"><h2>Networks</h2></div>
  {{if .Networks}}<div class="tw"><table><thead><tr><th>Name</th><th>Driver</th><th>Subnet</th><th>Gateway</th></tr></thead><tbody>
  {{range .Networks}}<tr><td class="mono">{{.Name}}{{if .Mine}} <span class="chip">cluster</span>{{end}}</td><td class="mono">{{.Driver}}</td><td class="mono">{{.Subnet}}</td><td class="mono">{{.Gateway}}</td></tr>{{end}}
  </tbody></table></div>{{else}}<div class="empty">No network read yet.</div>{{end}}</section>
<section class="panel"><div class="ph"><h2>Volumes and mounts</h2></div>
  {{if .Mounts}}<div class="tw"><table><thead><tr><th>Mount</th><th>Source</th><th></th></tr></thead><tbody>
  {{range .Mounts}}<tr><td class="mono">{{.Path}}</td><td class="mono">{{.Source}}</td><td>{{template "pg-ok" .OK}}</td></tr>{{end}}
  </tbody></table></div>
  {{else if .Volumes}}<div class="tw"><table><thead><tr><th>Volume</th><th>Driver</th></tr></thead><tbody>
  {{range .Volumes}}<tr><td class="mono">{{.Name}}</td><td class="mono">{{.Driver}}</td></tr>{{end}}
  </tbody></table></div>{{else}}<div class="empty">No volume or mount read yet.</div>{{end}}</section></div>
{{with .HostData}}<div class="callout warn pg-hint">Jobs write to <span class="mono">{{.}}</span> on this host as root. Pick a scratch directory, not your home directory.</div>{{end}}{{end}}

{{define "pg-tab-connect"}}<div class="grid g2"><section class="panel"><div class="ph"><h2>From your terminal</h2></div><div class="pb stack">
  {{range .Commands}}{{template "pg-cmd" .}}{{end}}</div></section>
<section class="panel"><div class="ph"><h2>Services</h2></div><div class="pb stack">
  {{if .API}}<dl class="kv"><dt><span data-word="slurmrestd">slurmrestd</span></dt><dd class="mono">{{.API}}</dd></dl>{{else}}<p class="muted pg-flat">No api node, so no slurmrestd. Add <span class="mono">api</span> to the nodes of the config.</p>{{end}}
  {{with .Grafana}}<dl class="kv"><dt>Grafana</dt><dd class="mono">{{.}}</dd></dl>{{end}}</div></section></div>
<p class="muted pg-hint">There is no terminal in the browser. Each command runs in your own terminal.</p>{{end}}
