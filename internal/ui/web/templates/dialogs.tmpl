{{/*
  Dialogs of the actions. A page opens one with
  <button hx-get="/dialogs/ID?realm=R&cluster=C" hx-target="#layer">: the
  answer is "act-dialog", which fills the layer of the layout. The form asks
  /actions/ID/preview for the command as it changes, and runs it with
  /actions/ID/run. A dialog shows the command it runs; it never sends one.
  The views are the *View of the request; the dialog or the preview is its
  Data. act.js makes the page behind a dialog inert, asks before a close
  loses changes, and keeps the draft of a dialog with data-act-draft.
*/}}

{{define "act-dialog"}}{{template "act-frame" .Data}}{{end}}

{{define "act-dialog-page"}}{{template "act-frame" .Data}}{{end}}

{{define "act-frame"}}
<div class="scrim" id="act-dialog"{{if not .Spec.Draft}} data-act-scrim{{end}}>
<form class="modal{{if .Spec.Wide}} wide{{end}}{{if .Spec.Plan}} split{{end}}" autocomplete="off" role="dialog" aria-modal="true" aria-labelledby="act-title" aria-describedby="act-lead" tabindex="-1"
  {{- if .Spec.Draft}} data-act-draft="{{.ID}}"{{end}}{{if .Draft}} data-act-restored{{end}}
  hx-post="/actions/{{.ID}}/run" hx-target="#act-preview" hx-swap="innerHTML">
  {{template "csrf-field" .View}}
  {{if not .Spec.RealmField}}<input type="hidden" name="realm" value="{{.Realm}}">{{end}}{{if .Cluster}}<input type="hidden" name="cluster" value="{{.Cluster}}">{{end}}
  <div class="mh"><div class="mtop"><h2 id="act-title">{{.Title}}</h2><button type="button" class="iconbtn" data-help-open="{{.ID}}" aria-label="Help for this dialog" title="Help for this dialog">?</button></div>
    <p id="act-lead">{{.Lead}}</p></div>
  {{if .Draft}}<div class="callout act-draftbar"><span>This is your draft from before.</span><button type="button" class="btn sm" data-act-restart>Start over</button></div>{{end}}
  {{if .Spec.Plan}}
  <div class="mb">
    <div class="act-form{{if .YAMLMode}} act-yamlmode{{end}}">{{include .Body .}}</div>
    <aside class="act-planpane" aria-label="Plan">{{template "act-preview-slot" .}}</aside>
  </div>
  {{else}}
  <div class="mb">
    {{include .Body .}}
    {{with .Typed}}<div class="fld"><label for="act-confirm">Type <b class="mono">{{.}}</b> to confirm</label><input type="text" id="act-confirm" name="confirm" autocomplete="off" spellcheck="false"></div>{{end}}
    {{template "act-preview-slot" .}}
  </div>
  {{end}}
  <div class="mf" id="act-mf">{{if .Spec.Plan}}<span class="act-status" id="act-status"></span>{{end}}<button type="button" class="btn" data-act-close>Cancel</button>{{template "act-ok" .OKButton}}</div>
  <div class="mf act-ask" id="act-ask" role="group" aria-labelledby="act-ask-q" hidden>
    <span class="act-askq" id="act-ask-q"><span class="pill warn nodot">Unsaved</span> <span data-act-ask="close">Close and lose your changes<span data-act-ask-of hidden> to <b class="mono" data-act-ask-name></b></span>?</span><span data-act-ask="restart" hidden>Start over and lose your changes?</span></span>
    <button type="button" class="btn" data-act-keep>Keep editing</button><button type="button" class="btn danger solid" data-act-discard>Discard</button>
  </div>
  {{if .Spec.Plan}}<span class="act-vh" id="act-say" role="status"></span>{{end}}
</form>
</div>
{{end}}

{{/* act-ok is the button that runs the command, an actOK. It is off until
a preview says that the command can run, and each preview swaps it.
Ctrl+Enter, or Cmd+Enter on macOS, presses it. */}}
{{define "act-ok"}}<button type="submit" class="btn {{if .Danger}}danger solid{{else}}primary{{end}}" id="act-ok" aria-keyshortcuts="Control+Enter Meta+Enter"{{if .Swap}} hx-swap-oob="true"{{end}}{{if .Off}} disabled{{end}}>{{.Label}}<kbd class="act-kbd" aria-hidden="true"><span class="act-k-ctrl">Ctrl</span><span class="act-k-cmd">⌘</span> ↵</kbd></button>{{end}}

{{define "act-preview-slot"}}<div id="act-preview" class="stack" hx-post="/actions/{{.ID}}/preview" hx-target="this" hx-swap="innerHTML"
      hx-trigger="load, input from:closest form delay:150ms, change from:closest form"></div>{{end}}

{{/* act-preview is the answer to a preview: the command, what to know about
it, and the button and the parts of the dialog that depend on it. */}}
{{define "act-preview"}}{{with .Data}}{{$p := .}}
{{if .Shown}}<input type="hidden" name="shown" value="{{.Shown}}">{{end}}
{{if .Spec.Plan}}{{template "act-plan" .}}{{else}}
{{if .ErrAtField}}<p class="hint act-missing">Fix the field above to see the command.</p>{{else if .Err}}<div class="callout bad">{{.Err}}</div>{{else if .Hint}}<p class="hint act-missing">{{.Hint}}</p>{{else}}
<div><div class="cmdlabel">Runs</div><div class="cmd"><code>{{.Cmd.Display}}</code><button type="button" data-copy="{{.Cmd.Display}}">Copy</button></div></div>
{{end}}
{{template "act-callouts" .}}
{{end}}
{{template "act-ok" .OKButton}}
{{range .Fields}}<span class="err" id="act-err-{{.}}" hx-swap-oob="innerHTML">{{$p.ProblemOf .}}</span>{{end}}
{{if .Spec.Plan}}{{range .NodeViews}}<span id="act-chip-{{.Key}}"{{if .Own}} class="own"{{end}} hx-swap-oob="true">{{.Chip}}</span>{{if .Group}}<span class="hint" id="act-range-{{.Key}}" hx-swap-oob="true">{{$p.RangeOf .Key}}</span>{{end}}{{end}}
{{with .Eff}}<span id="act-eff" hidden hx-swap-oob="true" data-image="{{.Image}}" data-cpus="{{.CPUs}}" data-memory="{{.Memory}}" data-tmp="{{.TmpSize}}"></span>{{end}}
<span class="hint" id="act-pull-hint" data-act-pull="{{if .PullOn}}on{{else}}off{{end}}" hx-swap-oob="true">{{.PullHint}}</span>
<datalist id="act-dl-groups" hx-swap-oob="true">{{range .GroupNames}}<option value="{{.}}"></option>{{end}}</datalist><datalist id="act-dl-accounts" hx-swap-oob="true">{{range .AccountNames}}<option value="{{.}}"></option>{{end}}</datalist>
{{range .SlurmFiles}}<span class="act-dot" id="act-dot-{{.ID}}" hx-swap-oob="true">{{if $p.SlurmSet .ID}} •{{end}}</span>{{end}}
{{range .Sections}}<span class="act-ss" id="act-sum-{{.ID}}" hx-swap-oob="innerHTML">{{.Summary}}</span><span class="act-sb" id="act-bad-{{.ID}}" hx-swap-oob="innerHTML">{{with .Bad}}{{.}} problem{{if ne . 1}}s{{end}}{{end}}</span>{{end}}{{end}}
{{if .Spec.Plan}}<span class="act-status" id="act-status" hx-swap-oob="innerHTML">{{template "act-status" .}}</span>{{end}}
{{end}}{{end}}

{{/* act-callouts are what to know about the command of a preview. */}}
{{define "act-callouts"}}
{{if .Warn}}<div class="callout warn">{{.Warn}}</div>{{end}}
{{if and .Lock (not .Err)}}<div class="callout warn">Another command holds the lock of realm <b class="mono">{{.Realm}}</b>: <span class="mono">{{.Lock.String}}</span>. The command waits until it ends; its run page shows the realm lock wait.</div>{{end}}
{{range .Cmd.Notes}}<div class="callout">{{.}}</div>{{end}}
{{range .Cmd.Warns}}<div class="callout warn">{{.}}</div>{{end}}
{{end}}

{{/* act-status is the status in the footer of a dialog with a plan: a
button that goes to the first problem, or Ready, and what the nodes of the
plan use. act.js says the status to assistive technology when its
data-act-key changes. */}}
{{define "act-status"}}
{{- if not .Blocked}}<span class="pill {{if .Warnings}}warn{{else}}ok{{end}}" data-act-say="{{.Say}}" data-act-key="{{.SayKey}}">Ready{{with .Warnings}} · {{.}} warning{{if ne . 1}}s{{end}}{{end}}</span>
{{- else if .Problems}}<button type="button" class="pill bad nodot act-go" data-act-go="{{.First.Field}}" data-act-say="{{.Say}}" data-act-key="{{.SayKey}}" aria-label="{{.StatusText}}. {{.StatusGo}}." title="{{.StatusGo}}">{{.StatusText}} <span aria-hidden="true">↑</span></button>
{{- else}}<span class="pill bad" data-act-say="{{.Say}}" data-act-key="{{.SayKey}}">Not ready</span>{{end}}
{{- with .Totals}}<span class="act-tot">{{.}}</span>{{end}}{{end}}

{{/* act-pill says whether the command can run, and with how many
warnings. */}}
{{define "act-pill"}}{{if .Blocked}}<span class="pill bad">Not ready · {{.Problems}} problem{{if ne .Problems 1}}s{{end}}</span>{{else if .Warnings}}<span class="pill warn">Ready · {{.Warnings}} warning{{if ne .Warnings 1}}s{{end}}</span>{{else}}<span class="pill ok">Ready</span>{{end}}{{end}}

{{/* act-plan is the plan pane of a dialog that makes a cluster: it shows
the nodes, the command and the config also while a field is wrong. */}}
{{define "act-plan"}}{{$p := .}}
<div class="act-ph"><h3>Plan</h3>{{template "act-pill" .}}</div>
{{if .Err}}<div class="callout bad" id="act-probs" tabindex="-1">{{.Err}}</div>{{else}}
<div class="act-tools">{{if not .YAMLMode}}<button type="button" class="btn sm" data-act-yaml-edit>Edit YAML</button>{{end}}<button type="button" class="btn sm" data-copy="{{.Cmd.Config.Content}}">Copy YAML</button></div>
{{with .Cmd.Problems}}<div class="callout bad act-probs" id="act-probs" tabindex="-1"><b>Fix these to create the cluster:</b><ul>{{range .}}<li>{{if .Field}}<a href="#act-{{.Field}}" data-act-jump="{{.Field}}">{{.Label}}</a>{{else}}<b>{{.Label}}</b>{{end}}: {{.Text}}</li>{{end}}</ul></div>{{end}}
{{with .Defaulted}}<p class="hint">The plan takes the defaults for {{.}} until you fix them.</p>{{end}}
<div class="act-tiles">{{range .Tiles}}<span class="act-tile {{.Role}}">{{.Short}}</span>{{end}}{{with .More}}<span class="act-tile more">{{.}} more</span>{{end}}</div>
<p class="hint">{{.Cmd.Summary}}</p>
{{with .HostMB}}<div class="act-meter"><meter min="0" max="{{.}}" value="{{$p.Cmd.MemoryMB}}" high="{{$p.HostHigh}}" optimum="0" aria-label="Memory of the Docker host"></meter><span class="hint">{{$p.MemoryLabel $p.Cmd.MemoryMB}} of the {{$p.MemoryLabel .}} of the Docker host</span></div>{{end}}
{{if .Cmd.OverHost}}<label class="act-nr act-box"><input type="checkbox" id="act-overcommit" name="overcommit"{{if .Form.Get "overcommit"}} checked{{end}} data-act-hold aria-describedby="act-hint-overcommit"><span class="act-lab"><b>Create anyway</b><span class="hint" id="act-hint-overcommit">Docker caps the memory of each node but sets none aside, so idle nodes use less. Jobs that use it all make the host run out of memory.</span></span></label>{{end}}
{{with .Cmd.Images}}<div class="act-imgs"><div class="cmdlabel">Images</div>{{range .}}<div class="act-img"><span class="mono">{{.Image}}</span><small>{{.Of}}</small>
  <span class="hint{{if .Version}} act-ver{{end}}">{{$p.ImageLine .}}</span>{{if .CanCheck}}<button type="button" class="btn sm" hx-post="/actions/create-cluster/check" hx-vals="{{$p.CheckVals .Image}}" hx-target="#act-preview" hx-swap="innerHTML" hx-disabled-elt="this">Check image</button>{{end}}</div>{{end}}</div>{{end}}
<div><div class="cmdlabel">Runs</div><div class="cmd"><code>{{.Cmd.Display}}</code><button type="button" data-copy="{{.Cmd.Script}}">Copy script</button></div>
  <p class="hint">The script saves the config{{if .Cmd.Dirs}}, creates the directory{{end}} and runs the command, as Create does.</p></div>
{{with .Cmd.After}}<div><div class="cmdlabel">Then sind runs</div><pre class="term act-after">{{range $i, $s := .}}{{if $i}}
{{end}}# {{.Where}}
{{range .Lines}}{{.}}
{{end}}{{end}}</pre></div>{{end}}
{{template "act-callouts" .}}
{{if .YAMLMode}}<div><div class="cmdlabel">Config <span class="act-path">{{.Cmd.Config.Path}}</span></div><p class="hint">The YAML that you edit, as it is.</p>{{template "act-slurmconf" .}}</div>
{{else}}<div><div class="cmdlabel">Config <span class="act-path">{{.Cmd.Config.Path}}</span></div><pre class="term act-yaml">{{.Cmd.Config.Content}}</pre>
  {{template "act-slurmconf" .}}
  <p class="hint">Edit YAML, at the top of the plan, gives you the whole config, also what the form has no field for, such as named Slurm config fragments or capabilities of the node defaults. The form stays locked until you discard the edits.</p></div>{{end}}
{{end}}
{{end}}

{{/* act-slurmconf is the slurm.conf that sind writes for the config of
the plan, folded; act.js keeps it open across the previews. */}}
{{define "act-slurmconf"}}{{with .Cmd.SlurmConf}}<details class="act-conf" id="act-conf" data-act-hold><summary>Preview slurm.conf</summary>
  <pre class="term act-confpre">{{.}}</pre>
  <p class="hint">sind's lines, then those of Slurm config, then the include of sind-nodes.conf with the workers and the partition all. The other files of Slurm config are files of their own.</p></details>{{end}}{{end}}

{{/* act-chip is the size button of a node of a new cluster, which opens
its editor. */}}
{{define "act-chip"}}<button type="button" class="act-cz" data-act-ed="{{.Key}}" aria-expanded="{{if .Open}}true{{else}}false{{end}}" aria-controls="act-ed-{{.Key}}" aria-labelledby="act-czl-{{.Key}}{{if .Group}} act-range-{{.Key}}{{end}} act-chip-{{.Key}}"><span class="vh" id="act-czl-{{.Key}}">Size of {{.Label}}</span>{{template "act-chip-text" .}}</button>{{end}}

{{define "act-chip-text"}}<span id="act-chip-{{.Key}}"{{if .Own}} class="own"{{end}}>{{.Chip}}</span>{{end}}

{{/* act-group is a worker group of a new cluster: its row and editor. */}}
{{define "act-group"}}<div class="act-nr act-wgrow" id="act-wg-{{.Key}}"><span><input type="hidden" name="wg" value="{{.Key}}"></span><i class="act-sq worker"></i><label class="act-lab" for="act-{{.Key}}-count"><b>workers</b><span class="hint" id="act-range-{{.Key}}">{{.Range}}</span><span class="err" id="act-err-{{.Key}}-count"></span></label>{{template "act-chip" .}}
  <span class="act-k"><span class="act-step"><button type="button" id="act-{{.Key}}-less" data-act-step="{{.Key}}-count" data-d="-1" aria-label="Fewer workers" aria-labelledby="act-{{.Key}}-less act-range-{{.Key}}">−</button><input type="number" id="act-{{.Key}}-count" name="{{.Key}}-count" value="{{.Val "count"}}" min="1" aria-describedby="act-err-{{.Key}}-count"><button type="button" id="act-{{.Key}}-more" data-act-step="{{.Key}}-count" data-d="1" aria-label="More workers" aria-labelledby="act-{{.Key}}-more act-range-{{.Key}}">+</button></span><button type="button" class="act-x" id="act-{{.Key}}-del" data-act-wgdel="{{.Key}}" aria-label="Remove the worker group" aria-labelledby="act-{{.Key}}-del act-range-{{.Key}}">✕</button></span></div>
{{template "act-ned" .}}{{end}}

{{/* act-ned is the editor of the size and more of a node of a new
cluster. An empty field takes the node defaults, which it shows as its
placeholder. */}}
{{define "act-ned"}}<div class="act-ned" id="act-ed-{{.Key}}"{{if not .Open}} hidden{{end}}>
  <div class="act-edg">
    <div class="fld"><label for="act-{{.Key}}-image">Image</label><input type="text" id="act-{{.Key}}-image" name="{{.Key}}-image" value="{{.Val "image"}}" placeholder="{{.Eff.Image}}" data-act-ph="image" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-image"><span class="err" id="act-err-{{.Key}}-image"></span></div>
    <div class="fld"><label for="act-{{.Key}}-cpus">CPUs</label><input type="number" id="act-{{.Key}}-cpus" name="{{.Key}}-cpus" value="{{.Val "cpus"}}" min="1" placeholder="{{.Eff.CPUs}}" data-act-ph="cpus" aria-describedby="act-err-{{.Key}}-cpus"><span class="err" id="act-err-{{.Key}}-cpus"></span></div>
    <div class="fld"><label for="act-{{.Key}}-memory">Memory</label><input type="text" id="act-{{.Key}}-memory" name="{{.Key}}-memory" value="{{.Val "memory"}}" list="act-memories" placeholder="{{.Eff.Memory}}" data-act-ph="memory" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-memory"><span class="err" id="act-err-{{.Key}}-memory"></span></div>
    <div class="fld"><label for="act-{{.Key}}-tmp">/tmp</label><input type="text" id="act-{{.Key}}-tmp" name="{{.Key}}-tmp" value="{{.Val "tmp"}}" placeholder="{{.Eff.TmpSize}}" data-act-ph="tmp" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-tmp"><span class="err" id="act-err-{{.Key}}-tmp"></span></div>
  </div>
  <div class="act-inline"><span class="hint">Empty fields take the node defaults.{{if eq .Key "controller"}} The backup controller gets the same values.{{end}}</span><button type="button" class="btn sm" data-act-reset="{{.Key}}">Use the defaults</button></div>
  <details class="act-more"><summary>More: managed, capabilities, devices</summary>
    <div class="act-edg">
      {{if .Managed}}<label class="act-nr act-box act-full"><input type="checkbox" id="act-{{.Key}}-unmanaged" name="{{.Key}}-unmanaged"{{if .On "unmanaged"}} checked{{end}} aria-describedby="act-err-{{.Key}}-unmanaged"><span class="act-lab"><b>Unmanaged</b><span class="hint">{{.UnmanagedHint}}</span><span class="err" id="act-err-{{.Key}}-unmanaged"></span></span></label>{{end}}
      {{range .Lists}}<div class="fld"><label for="act-{{$.Key}}-{{.Attr}}">{{.Attr}}</label><input type="text" id="act-{{$.Key}}-{{.Attr}}" name="{{$.Key}}-{{.Attr}}" value="{{$.Val .Attr}}" placeholder="{{.Example}}" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{$.Key}}-{{.Attr}}"><span class="err" id="act-err-{{$.Key}}-{{.Attr}}"></span></div>{{end}}
      <span class="hint act-full">These give the container more rights on the host. They add to those of the node defaults. Separate values with commas.</span>
    </div>
  </details>
</div>{{end}}

{{/* act-user is a row of a user of a new cluster. */}}
{{define "act-user"}}<div class="act-row" id="act-row-{{.Key}}" data-act-row><input type="hidden" name="ur" value="{{.Key}}">
  <div class="act-rowf">
    <input type="text" id="act-{{.Key}}-name" name="{{.Key}}-name" value="{{.Val "name"}}" placeholder="name, such as alice" aria-label="User name" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-name">
    <input type="number" id="act-{{.Key}}-uid" name="{{.Key}}-uid" value="{{.Val "uid"}}" min="1000" placeholder="UID: auto" aria-label="UID" aria-describedby="act-err-{{.Key}}-uid">
    <input type="text" id="act-{{.Key}}-accounts" name="{{.Key}}-accounts" value="{{.Val "accounts"}}" list="act-dl-accounts" placeholder="Slurm accounts" aria-label="Slurm accounts, the first is the default" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-accounts">
    <button type="button" class="act-x" id="act-{{.Key}}-del" data-act-rowdel aria-label="Remove the user" aria-labelledby="act-{{.Key}}-del act-{{.Key}}-name">✕</button>
  </div>
  <span class="err" id="act-err-{{.Key}}-name"></span><span class="err" id="act-err-{{.Key}}-uid"></span><span class="err" id="act-err-{{.Key}}-accounts"></span>
  <details class="act-more"{{if or (.Val "group") (.Val "groups") (.Val "coordinator") (.Val "admin")}} open{{end}}><summary>More: groups, coordinator, admin level</summary>
    <div class="act-edg">
      <div class="fld"><label for="act-{{.Key}}-group">Primary group</label><input type="text" id="act-{{.Key}}-group" name="{{.Key}}-group" value="{{.Val "group"}}" list="act-dl-groups" placeholder="its own" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-group"><span class="err" id="act-err-{{.Key}}-group"></span></div>
      <div class="fld"><label for="act-{{.Key}}-groups">Groups</label><input type="text" id="act-{{.Key}}-groups" name="{{.Key}}-groups" value="{{.Val "groups"}}" list="act-dl-groups" placeholder="none" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-groups"><span class="err" id="act-err-{{.Key}}-groups"></span></div>
      <div class="fld"><label for="act-{{.Key}}-coordinator">Coordinator of</label><input type="text" id="act-{{.Key}}-coordinator" name="{{.Key}}-coordinator" value="{{.Val "coordinator"}}" list="act-dl-accounts" placeholder="no account" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-coordinator"><span class="err" id="act-err-{{.Key}}-coordinator"></span></div>
      <div class="fld"><label for="act-{{.Key}}-admin">Admin level</label><select id="act-{{.Key}}-admin" name="{{.Key}}-admin" aria-describedby="act-err-{{.Key}}-admin">{{$a := .Val "admin"}}<option value=""{{if eq $a ""}} selected{{end}}>None</option><option value="operator"{{if eq $a "operator"}} selected{{end}}>Operator</option><option value="admin"{{if eq $a "admin"}} selected{{end}}>Admin</option></select><span class="err" id="act-err-{{.Key}}-admin"></span></div>
      <span class="hint act-full">Separate groups and accounts with commas. Coordinator and admin level need an account.</span>
    </div>
  </details>
</div>{{end}}

{{/* act-group-row is a row of a group of a new cluster. */}}
{{define "act-group-row"}}<div class="act-row" id="act-row-{{.Key}}" data-act-row><input type="hidden" name="gr" value="{{.Key}}">
  <div class="act-rowf">
    <input type="text" id="act-{{.Key}}-name" name="{{.Key}}-name" value="{{.Val "name"}}" placeholder="name, such as hpc" aria-label="Group name" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-name">
    <input type="number" id="act-{{.Key}}-gid" name="{{.Key}}-gid" value="{{.Val "gid"}}" min="1000" placeholder="GID: auto" aria-label="GID" aria-describedby="act-err-{{.Key}}-gid">
    <button type="button" class="act-x" id="act-{{.Key}}-del" data-act-rowdel aria-label="Remove the group" aria-labelledby="act-{{.Key}}-del act-{{.Key}}-name">✕</button>
  </div>
  <span class="err" id="act-err-{{.Key}}-name"></span><span class="err" id="act-err-{{.Key}}-gid"></span>
</div>{{end}}

{{/* act-account is a row of a Slurm account of a new cluster, with its
limits as pairs of fields. */}}
{{define "act-account"}}<div class="act-row" id="act-row-{{.Key}}" data-act-row><input type="hidden" name="ar" value="{{.Key}}">
  <div class="act-rowf">
    <input type="text" id="act-{{.Key}}-name" name="{{.Key}}-name" value="{{.Val "name"}}" placeholder="name, such as physics" aria-label="Account name" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-name">
    <input type="text" id="act-{{.Key}}-parent" name="{{.Key}}-parent" value="{{.Val "parent"}}" list="act-dl-accounts" placeholder="parent: root" aria-label="Parent account" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-parent">
    <button type="button" class="act-x" id="act-{{.Key}}-del" data-act-rowdel aria-label="Remove the account" aria-labelledby="act-{{.Key}}-del act-{{.Key}}-name">✕</button>
  </div>
  <span class="err" id="act-err-{{.Key}}-name"></span><span class="err" id="act-err-{{.Key}}-parent"></span>
  <div class="act-lims" id="act-lims-{{.Key}}">{{range .Limits}}{{template "act-limit" .}}{{end}}</div>
  <span class="err" id="act-err-{{.Key}}-lk"></span>
  <button type="button" class="btn sm" data-act-rowadd="limit" data-act-into="act-lims-{{.Key}}" data-act-key="{{.Key}}">+ Add limit</button>
</div>{{end}}

{{/* act-limit is a limit of an account: a pair of fields. */}}
{{define "act-limit"}}<div class="act-rowf act-lim" data-act-row>
  <input type="text" name="{{.Row}}-lk" value="{{.Key}}" list="act-dl-limits" placeholder="limit, such as MaxJobs" aria-label="Limit" autocapitalize="off" spellcheck="false">
  <input type="text" name="{{.Row}}-lv" value="{{.Value}}" placeholder="value, such as 4" aria-label="Value of the limit" autocapitalize="off" spellcheck="false">
  <button type="button" class="act-x" data-act-rowdel aria-label="Remove this limit">✕</button>
</div>{{end}}

{{/* act-realm is the realm field of a dialog with Spec.RealmField: the
realm of the link, another one that sind ui sees, or a new one. */}}
{{define "act-realm"}}<div class="fld"><label for="act-realm">Realm</label><input type="text" id="act-realm" name="realm" value="{{.Realm}}" list="act-dl-realms" autocapitalize="off" spellcheck="false" aria-describedby="act-err-realm act-hint-realm">
  <span class="err" id="act-err-realm"></span><span class="hint" id="act-hint-realm">{{.RealmHint}}</span>
  <datalist id="act-dl-realms">{{range .RealmNames}}<option value="{{.}}"></option>{{end}}</datalist></div>{{end}}

{{/* act-nodes is the picker of the nodes of a cluster. */}}
{{define "act-nodes"}}<div class="fld"><span class="lbl">Nodes of {{.Cluster}}</span>
  {{if .Nodes}}<div class="checks act-nodes">{{range .Nodes}}<label><input type="checkbox" name="nodes" value="{{.Short}}"{{if .On}} checked{{end}}> <span class="mono">{{.Short}}</span> <small>{{.Role}}, {{.State}}</small></label>{{end}}</div>
  {{else}}<div class="empty">sind ui sees no node of {{.Cluster}} yet.</div>{{end}}</div>{{end}}

{{define "act-dlg-create-cluster"}}
<div class="row act-idrow">
  <div class="fld"><label for="act-name">Name</label><input type="text" id="act-name" name="name" value="{{.Val "name"}}" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="act-err-name act-hint-name">
    <span class="err" id="act-err-name"></span><span class="hint" id="act-hint-name">Lowercase letters, digits and -. 1 to 63 characters, 40 with a db node. Not ssh.</span></div>
  {{template "act-realm" .}}
</div>
<div class="act-inline act-yamlstart"><button type="button" class="btn sm" data-act-yaml-start>Start from YAML…</button><span class="hint">Paste a cluster config, or open a file of one.</span></div>
<div class="act-yamled" id="act-yamled"{{if not .YAMLMode}} hidden{{end}}>
  <input type="hidden" id="act-yaml-on" name="yaml_on" value="1"{{if not .YAMLMode}} disabled{{end}}>
  <div class="callout act-yamlbar"><span><b>You edit the YAML.</b> The plan follows it, and Name and Realm change the name and the realm in it. The rest of the form is locked; Run options still apply.</span><button type="button" class="btn sm" data-act-yaml-discard>Discard YAML edits</button></div>
  <div class="act-inline act-yamlhead"><label class="lbl" for="act-yaml">Config</label><button type="button" class="btn sm" data-act-yaml-open aria-describedby="act-hint-yaml">Open a file…</button>
    <input type="file" id="act-yaml-file" accept=".yaml,.yml,application/yaml,text/yaml,text/plain" hidden></div>
  <textarea id="act-yaml" name="yaml" rows="26" placeholder="kind: Cluster&#10;name: hpc&#10;nodes:&#10;  - controller&#10;  - worker: 2" autocapitalize="off" spellcheck="false" aria-describedby="act-err-yaml act-hint-yaml"{{if not .YAMLMode}} disabled{{end}}>{{.Val "yaml"}}</textarea>
  <span class="err" id="act-err-yaml"></span><span class="hint" id="act-hint-yaml">Paste a config, open a file, or drop one here. At most 64 KiB.</span>
</div>
<div class="fld"><label for="act-image">Image</label><input type="text" id="act-image" name="image" value="{{.Val "image"}}" autocapitalize="off" spellcheck="false" aria-describedby="act-err-image act-hint-image">
  <span class="err" id="act-err-image"></span><span class="hint" id="act-hint-image">The Slurm release of the image is the cluster's.</span></div>
<div class="fld"><span class="lbl">Nodes</span>
<div class="act-roles" id="act-roles">
  <div class="act-nr"><span></span><i class="act-sq controller"></i><span class="act-lab"><b data-word="controller">controller</b><span class="hint"><span data-word="slurmctld">slurmctld</span>. Every cluster has one.</span></span>{{template "act-chip" (.Node "controller")}}<span class="act-always">always</span></div>
  {{template "act-ned" (.Node "controller")}}
  {{range .Roles}}<div class="act-nr{{if .Sub}} sub{{end}}"><input type="checkbox" id="act-{{.Name}}" name="{{.Name}}"{{if $.On .Name}} checked{{end}} aria-describedby="act-err-{{.Name}}"><i class="act-sq {{.Name}}"></i><label class="act-lab" for="act-{{.Name}}"><b>{{.Label}}{{with .Small}} <small>{{.}}</small>{{end}}</b><span class="hint">{{.Hint}}</span><span class="err" id="act-err-{{.Name}}"></span></label>{{if not .Sub}}{{template "act-chip" ($.Node .Name)}}{{end}}</div>
  {{if not .Sub}}{{template "act-ned" ($.Node .Name)}}{{end}}{{end}}
  <div class="act-groups" id="act-groups">{{range .Groups}}{{template "act-group" ($.Node .)}}{{end}}</div>
</div>
<div class="act-inline"><button type="button" class="btn sm" data-act-wgadd>+ Add worker group</button><span class="hint">Each group has its own size. sind create worker later copies the last group.</span></div>
<span id="act-eff" hidden></span>
<template id="act-wg-tpl">{{template "act-group" (.Node "__WG__")}}</template>
</div>
<label class="act-nr act-box"><input type="checkbox" id="act-monitoring" name="monitoring"{{if .On "monitoring"}} checked{{end}} aria-describedby="act-err-monitoring"><span class="act-lab"><b>Monitoring</b><span class="hint">Adds the nodes to the realm's Prometheus, Loki and Grafana. Needs Slurm 26.05 or later in the image.</span><span class="err" id="act-err-monitoring"></span></span></label>
<div class="fld"><span class="lbl" id="act-size-lbl">Node defaults</span>
  <div class="act-size">
    <div class="seg act-seg act-sizes" role="radiogroup" aria-labelledby="act-size-lbl">{{range .Sizes}}<label><input type="radio" name="size" value="{{.ID}}"{{if $.Is "size" .ID}} checked{{end}}{{if eq .ID "s"}} id="act-size"{{end}}><span>{{.Label}}<small>{{.CPUs}} CPU{{if ne .CPUs 1}}s{{end}} · {{.Memory}} · /tmp {{or .TmpSize "256m"}}</small></span></label>{{end}}<label><input type="radio" name="size" value="x"{{if .Is "size" "x"}} checked{{end}}><span>Custom<small>your values</small></span></label></div>
    <div class="row act-custom">
      <div class="fld"><label for="act-cpus">CPUs</label><input type="number" id="act-cpus" name="cpus" value="{{.Val "cpus"}}" min="1" aria-describedby="act-err-cpus"><span class="err" id="act-err-cpus"></span></div>
      <div class="fld"><label for="act-memory">Memory</label><input type="text" id="act-memory" name="memory" value="{{.Val "memory"}}" list="act-memories" placeholder="512m" autocapitalize="off" spellcheck="false" aria-describedby="act-err-memory act-hint-memory">
        <span class="err" id="act-err-memory"></span><span class="hint" id="act-hint-memory">Such as 512m, 2g or 1.5g.</span></div>
      <div class="fld"><label for="act-tmp">/tmp</label><input type="text" id="act-tmp" name="tmp" value="{{.Val "tmp"}}" placeholder="256m" autocapitalize="off" spellcheck="false" aria-describedby="act-err-tmp"><span class="err" id="act-err-tmp"></span></div>
    </div>
  </div>
  <span class="err" id="act-err-size"></span>
  <span class="hint">Every node takes these values. The size button of a node changes them for that node or worker group.</span>
  <datalist id="act-memories">{{range .Memories}}<option value="{{.}}"></option>{{end}}</datalist>
</div>
<details class="act-sec" id="act-sec-users"{{if or (.Rows "user") (.Rows "group") (.Rows "account")}} open{{end}}><summary><span class="act-st">Users and accounts</span><span class="act-ss" id="act-sum-users"></span><span class="act-sb" id="act-bad-users"></span></summary>
  <div class="act-sbody">
    <div class="fld"><span class="lbl">Users</span>
      <div class="act-rows" id="act-rows-user">{{range .Rows "user"}}{{template "act-user" .}}{{end}}</div>
      <div class="act-inline"><button type="button" class="btn sm" data-act-rowadd="user" data-act-into="act-rows-user" data-act-prefix="u">+ Add user</button><span class="hint">sind creates them on the nodes, with a home in /home. An empty UID takes the next free one from 1000.</span></div></div>
    <div class="fld"><span class="lbl">Groups</span>
      <div class="act-rows" id="act-rows-group">{{range .Rows "group"}}{{template "act-group-row" .}}{{end}}</div>
      <div class="act-inline"><button type="button" class="btn sm" data-act-rowadd="group" data-act-into="act-rows-group" data-act-prefix="g">+ Add group</button><span class="hint">For the group and groups of a user. Each user has a private group of its own name too.</span></div></div>
    <div class="fld"><span class="lbl">Slurm accounts</span>
      <div class="act-rows" id="act-rows-account">{{range .Rows "account"}}{{template "act-account" .}}{{end}}</div>
      <div class="act-inline"><button type="button" class="btn sm" data-act-rowadd="account" data-act-into="act-rows-account" data-act-prefix="a">+ Add account</button><span class="hint">Need the db node. sind creates them with sacctmgr below root, a parent before its children. A new cluster has only the QOS normal; sind creates no QOS.</span></div></div>
    <datalist id="act-dl-groups"></datalist><datalist id="act-dl-accounts"></datalist>
    <datalist id="act-dl-limits">{{range .LimitKeys}}<option value="{{.}}"></option>{{end}}</datalist>
    <template id="act-tpl-user">{{template "act-user" (.Row "__ROW__")}}</template>
    <template id="act-tpl-group">{{template "act-group-row" (.Row "__ROW__")}}</template>
    <template id="act-tpl-account">{{template "act-account" (.Row "__ROW__")}}</template>
    <template id="act-tpl-limit">{{template "act-limit" (.Row "__ROW__").Blank}}</template>
  </div>
</details>
<details class="act-sec" id="act-sec-identity"{{if ne (.Val "identity") "local"}} open{{end}}><summary><span class="act-st">Identity</span><span class="act-ss" id="act-sum-identity"></span><span class="act-sb" id="act-bad-identity"></span></summary>
  <div class="act-sbody act-ids">
    <div class="checks" role="radiogroup" aria-label="Identity mode">{{range .Identities}}<label><input type="radio" name="identity" value="{{.Mode}}"{{if $.Is "identity" (print .Mode)}} checked{{end}}{{if eq (print .Mode) "local"}} id="act-identity"{{end}}> <span class="mono">{{.Mode}}</span> <small>{{.Hint}}</small></label>{{end}}</div>
    <span class="err" id="act-err-identity"></span>
    <label class="act-nr act-box act-ctlusers"><input type="checkbox" id="act-ctlusers" name="ctlusers"{{if .On "ctlusers"}} checked{{end}} aria-describedby="act-err-ctlusers"><span class="act-lab"><b>Users on the controllers too</b><span class="hint">For a partition with AllowGroups: slurmctld checks the groups on its own node.</span><span class="err" id="act-err-ctlusers"></span></span></label>
    <span class="hint">Where the nodes find the users, and how Slurm authenticates them. nssSlurm and clientIds need a managed cluster.</span>
  </div>
</details>
<details class="act-sec act-slurm" id="act-sec-slurm"{{range .SlurmFiles}}{{if $.Val (print "slurm-" .ID)}} open{{end}}{{end}}><summary><span class="act-st">Slurm config</span><span class="act-ss" id="act-sum-slurm"></span><span class="act-sb" id="act-bad-slurm"></span></summary>
  <div class="act-sbody">
    <div class="seg act-seg act-stabs" role="radiogroup" aria-label="Slurm config file">{{range .SlurmFiles}}<label><input type="radio" name="stab" value="{{.ID}}"{{if $.Is "stab" .ID}} checked{{end}}><span>{{.ID}}<span class="act-dot" id="act-dot-{{.ID}}"></span></span></label>{{end}}</div>
    {{range .SlurmFiles}}<div class="fld act-sl act-sl-{{.ID}}"><label for="act-slurm-{{.ID}}">Lines to add to <span class="mono">{{.File}}</span></label>
      <textarea id="act-slurm-{{.ID}}" name="slurm-{{.ID}}" rows="6" placeholder="such as {{.Example}}" autocapitalize="off" spellcheck="false" aria-describedby="act-err-slurm-{{.ID}}">{{$.Val (print "slurm-" .ID)}}</textarea><span class="err" id="act-err-slurm-{{.ID}}"></span></div>{{end}}
    <span class="hint">sind writes these lines after its own, and Slurm takes the last value of a parameter, so yours wins. sind checks only a few parameters, such as SlurmctldHost with a backup controller and the database ones of slurmdbd.conf. The plan warns when slurm.conf sets ClusterName, SlurmctldHost, SlurmUser, the spool directories or PlugStackConfig, which the cluster needs as sind sets them.</span>
  </div>
</details>
<details class="act-sec" id="act-sec-data"><summary><span class="act-st">Data</span><span class="act-ss" id="act-sum-data"></span><span class="act-sb" id="act-bad-data"></span></summary>
  <div class="act-sbody">
    <div class="seg act-seg" role="radiogroup" aria-label="Data storage">
      <label><input type="radio" id="act-dtype" name="dtype" value="hostPath"{{if ne (.Val "dtype") "volume"}} checked{{end}}><span>Host directory</span></label><label><input type="radio" id="act-dtype-volume" name="dtype" value="volume"{{if eq (.Val "dtype") "volume"}} checked{{end}}><span>Docker volume</span></label></div>
    <span class="err" id="act-err-dtype"></span>
    <div class="row">
      <div class="fld act-wide"><label for="act-dir">Directory</label><input type="text" id="act-dir" name="dir" value="{{.Val "dir"}}" autocapitalize="off" spellcheck="false"{{if .DirFollows}} data-act-follow{{end}}{{if eq (.Val "dtype") "volume"}} readonly{{end}} aria-describedby="act-err-dir act-hint-dir">
        <span class="err" id="act-err-dir"></span><span class="hint" id="act-hint-dir">On the host. Jobs write here as root.</span></div>
      <div class="fld"><label for="act-mount">Mount path</label><input type="text" id="act-mount" name="mount" value="{{.Val "mount"}}" placeholder="/data" autocapitalize="off" spellcheck="false" aria-describedby="act-err-mount act-hint-mount">
        <span class="err" id="act-err-mount"></span><span class="hint" id="act-hint-mount">In the nodes.</span></div>
    </div>
    <label class="act-nr act-box"><input type="checkbox" id="act-mkdir" name="mkdir"{{if .On "mkdir"}} checked{{end}} aria-describedby="act-err-mkdir"><span class="act-lab"><b>Create the directory if it is missing</b><span class="hint">Docker mounts only a directory that exists.</span><span class="err" id="act-err-mkdir"></span></span></label>
    <label class="act-nr act-box"><input type="checkbox" id="act-cvmfs" name="cvmfs"{{if .On "cvmfs"}} checked{{end}} aria-describedby="act-err-cvmfs"><span class="act-lab"><b>CVMFS</b><span class="hint">Mounts CVMFS read-only at /cvmfs on every node, from the cvmfs Docker volume plugin or from /cvmfs of the host.</span><span class="err" id="act-err-cvmfs"></span></span></label>
    <span class="hint">sind ui writes the data storage into the config, so the saved file alone makes the same cluster again.</span>
  </div>
</details>
<details class="act-sec" id="act-sec-run"><summary><span class="act-st">Run options</span><span class="act-ss" id="act-sum-run"></span><span class="act-sb" id="act-bad-run"></span></summary>
  <div class="act-sbody">
    {{if .Val "pull_auto"}}<input type="hidden" id="act-pull-auto" name="pull_auto" value="1">{{end}}
    <label class="act-nr act-box"><input type="checkbox" id="act-pull" name="pull"{{if .On "pull"}} checked{{end}} aria-describedby="act-err-pull act-pull-hint"><span class="act-lab"><b>Pull the image</b><span class="hint" id="act-pull-hint">Gets the newest image first, even if Docker has one.</span><span class="err" id="act-err-pull"></span></span></label>
    <div class="fld"><span class="lbl" id="act-wait-lbl">Wait for ready</span>
      <div class="act-waits"><div class="seg act-seg" role="radiogroup" aria-labelledby="act-wait-lbl">{{range .Waits}}<label><input type="radio" name="wait" value="{{.Value}}"{{if $.Is "wait" .Value}} checked{{end}}{{if eq .Value "2m"}} id="act-wait"{{end}}><span>{{.Label}}</span></label>{{end}}</div>
      <input type="text" id="act-wait_other" name="wait_other" value="{{.Val "wait_other"}}" placeholder="such as 15m" autocapitalize="off" spellcheck="false" aria-label="Other time to wait" aria-describedby="act-err-wait_other"></div>
      <span class="err" id="act-err-wait"></span><span class="err" id="act-err-wait_other"></span>
      <span class="hint">For each node, from the start of its container; pulls do not count. If a node is not ready in time, sind removes the cluster again.</span></div>
  </div>
</details>
{{end}}

{{define "act-dlg-create-worker"}}
<div class="row">
  <div class="fld"><label for="act-count">How many</label><input type="number" id="act-count" name="count" value="{{.Val "count"}}" min="1"></div>
  <div class="fld"><label for="act-cpus">CPUs</label><input type="number" id="act-cpus" name="cpus" value="{{.Val "cpus"}}" placeholder="as the newest worker" min="1"></div>
  <div class="fld"><label for="act-memory">Memory</label><input type="text" id="act-memory" name="memory" value="{{.Val "memory"}}" placeholder="as the newest worker" autocapitalize="off" spellcheck="false"><span class="hint">Such as 1g or 512m.</span></div>
</div>
{{end}}

{{define "act-dlg-delete-cluster"}}
<div class="callout bad">This cannot be undone. Jobs, accounting and the Slurm state of {{.Cluster}} go with it. A host directory mounted as /data stays as it is; a data volume goes too.</div>
{{end}}

{{define "act-dlg-delete-worker"}}
{{template "act-nodes" .}}
<div class="callout bad">Jobs on these workers fail. This cannot be undone; add workers again to get new ones.</div>
{{end}}

{{define "act-dlg-power"}}
{{template "act-nodes" .}}
<div class="fld"><span class="lbl">What to do</span><div class="checks">
  {{range .Ops}}<label><input type="radio" name="op" value="{{.ID}}"{{if $.Is "op" .ID}} checked{{end}}> <span>{{.Label}} <small>{{.Text}}</small></span></label>{{end}}
</div></div>
{{end}}

{{define "act-dlg-connect"}}
<div class="fld"><label for="act-container">Container</label><input type="text" id="act-container" name="container" value="{{.Val "container"}}" placeholder="kind-control-plane" autocapitalize="off" spellcheck="false" aria-describedby="act-err-container act-hint-container"><span class="err" id="act-err-container"></span><span class="hint" id="act-hint-container">The name of a running container that no realm has yet.</span></div>
{{template "act-realm" .}}
{{end}}

{{define "act-dlg-disconnect"}}
<div class="fld"><label for="act-container">Container</label><input type="text" id="act-container" name="container" value="{{.Val "container"}}" placeholder="kind-control-plane" autocapitalize="off" spellcheck="false"><span class="hint">The name of a container that is connected to realm {{.Realm}}.</span></div>
{{end}}

{{define "act-dlg-delete-realm"}}
<div class="callout bad">This cannot be undone.</div>
{{end}}

{{/* act-started is the notice of a command that a dialog started, which
htmx adds to #act-notes of the layout. act.js takes it away after a while,
unless the pointer or the focus is on it. */}}
{{define "act-started"}}{{with .Data}}<div class="act-note" data-act-note><p>Started <code>{{.Display}}</code>. <a href="/tasks/{{.ID}}">Show progress</a></p><button type="button" class="iconbtn" data-act-note-close aria-label="Close this notice" title="Close">×</button></div>{{end}}{{end}}
