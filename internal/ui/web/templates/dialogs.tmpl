{{/*
  Dialogs of the actions. A page opens one with
  <button hx-get="/dialogs/ID?realm=R&cluster=C" hx-target="#layer">: the
  answer is "act-dialog", which fills the layer of the layout. The form asks
  /actions/ID/preview for the command as it changes, and runs it with
  /actions/ID/run. A dialog shows the command it runs; it never sends one.
  The views are the *View of the request; the dialog or the preview is its
  Data.
*/}}

{{define "act-dialog"}}{{template "act-frame" .Data}}{{end}}

{{define "act-dialog-page"}}{{template "act-frame" .Data}}{{end}}

{{define "act-frame"}}
<div class="scrim" id="act-dialog" data-act-scrim>
<form class="modal{{if .Spec.Wide}} wide{{end}}{{if .Spec.Plan}} split{{end}}" autocomplete="off" role="dialog" aria-modal="true" aria-label="{{.Title}}"
  hx-post="/actions/{{.ID}}/run" hx-target="#act-preview" hx-swap="innerHTML">
  {{template "csrf-field" .View}}
  <input type="hidden" name="realm" value="{{.Realm}}">{{if .Cluster}}<input type="hidden" name="cluster" value="{{.Cluster}}">{{end}}
  <div class="mh"><div class="mtop"><h2>{{.Title}}</h2><button type="button" class="iconbtn" data-help-open="{{.ID}}" aria-label="Help for this dialog" title="Help for this dialog">?</button></div>
    <p>{{.Lead}}</p></div>
  {{if .Spec.Plan}}
  <div class="mb">
    <div class="act-form">{{include .Body .}}</div>
    <aside class="act-planpane" aria-label="Plan">{{template "act-preview-slot" .}}</aside>
  </div>
  {{else}}
  <div class="mb">
    {{include .Body .}}
    {{with .Typed}}<div class="fld"><label for="act-confirm">Type <b class="mono">{{.}}</b> to confirm</label><input type="text" id="act-confirm" name="confirm" autocomplete="off" spellcheck="false"></div>{{end}}
    {{template "act-preview-slot" .}}
  </div>
  {{end}}
  <div class="mf">{{if .Spec.Plan}}<span class="act-status" id="act-status" role="status"></span>{{end}}<button type="button" class="btn" data-act-close>Cancel</button><button type="submit" class="btn {{if .Spec.Danger}}danger solid{{else}}primary{{end}}" id="act-ok" disabled>{{.Spec.OK}}</button></div>
</form>
</div>
{{end}}

{{define "act-preview-slot"}}<div id="act-preview" class="stack" hx-post="/actions/{{.ID}}/preview" hx-target="this" hx-swap="innerHTML"
      hx-trigger="load, input from:closest form delay:150ms, change from:closest form"></div>{{end}}

{{/* act-preview is the answer to a preview: the command, what to know about
it, and the button and the parts of the dialog that depend on it. */}}
{{define "act-preview"}}{{with .Data}}{{$p := .}}
{{if .Shown}}<input type="hidden" name="shown" value="{{.Shown}}">{{end}}
{{if .Spec.Plan}}{{template "act-plan" .}}{{else}}
{{if .Err}}<div class="callout bad">{{.Err}}</div>{{else}}
<div><div class="cmdlabel">Runs</div><div class="cmd"><code>{{.Cmd.Display}}</code><button type="button" data-copy="{{.Cmd.Display}}">Copy</button></div></div>
{{end}}
{{template "act-callouts" .}}
{{end}}
<button type="submit" class="btn {{if .Danger}}danger solid{{else}}primary{{end}}" id="act-ok" hx-swap-oob="true"{{if .Blocked}} disabled{{end}}>{{.Spec.OK}}</button>
{{range .Spec.Fields}}<span class="err" id="act-err-{{.}}" hx-swap-oob="innerHTML">{{$p.ProblemOf .}}</span>{{end}}
{{if .Spec.Plan}}<span class="hint" id="act-pull-hint" data-act-pull="{{if .PullOn}}on{{else}}off{{end}}" hx-swap-oob="true">{{.PullHint}}</span>
{{range .Sections}}<span class="act-ss" id="act-sum-{{.ID}}" hx-swap-oob="innerHTML">{{.Summary}}</span><span class="act-sb" id="act-bad-{{.ID}}" hx-swap-oob="innerHTML">{{with .Bad}}{{.}} problem{{if ne . 1}}s{{end}}{{end}}</span>{{end}}{{end}}
{{if .Spec.Plan}}<span class="act-status" id="act-status" role="status" hx-swap-oob="true">{{template "act-pill" .}}</span>{{end}}
{{end}}{{end}}

{{/* act-callouts are what to know about the command of a preview. */}}
{{define "act-callouts"}}
{{if .Warn}}<div class="callout warn">{{.Warn}}</div>{{end}}
{{if and .Lock (not .Err)}}<div class="callout warn">Another command holds the lock of realm <b class="mono">{{.Realm}}</b>: <span class="mono">{{.Lock.String}}</span>. The command waits until it ends; its run page shows the realm lock wait.</div>{{end}}
{{range .Cmd.Notes}}<div class="callout">{{.}}</div>{{end}}
{{range .Cmd.Warns}}<div class="callout warn">{{.}}</div>{{end}}
{{end}}

{{/* act-pill says whether the command can run. */}}
{{define "act-pill"}}{{if .Blocked}}<span class="pill bad">Not ready · {{.Problems}} problem{{if ne .Problems 1}}s{{end}}</span>{{else}}<span class="pill ok">Ready</span>{{end}}{{end}}

{{/* act-plan is the plan pane of a dialog that makes a cluster: it shows
the nodes, the command and the config also while a field is wrong. */}}
{{define "act-plan"}}
<div class="act-ph"><h3>Plan</h3>{{template "act-pill" .}}</div>
{{if .Err}}<div class="callout bad">{{.Err}}</div>{{else}}
{{with .Cmd.Problems}}<div class="callout bad act-probs"><b>Fix these to create the cluster:</b><ul>{{range .}}<li>{{if .Field}}<a href="#act-{{.Field}}" data-act-jump="{{.Field}}">{{.Label}}</a>{{else}}<b>{{.Label}}</b>{{end}}: {{.Text}}</li>{{end}}</ul></div>{{end}}
{{with .Defaulted}}<p class="hint">The plan takes the defaults for {{.}} until you fix them.</p>{{end}}
<div class="act-tiles">{{range .Tiles}}<span class="act-tile {{.Role}}">{{.Short}}</span>{{end}}{{with .More}}<span class="act-tile more">{{.}} more</span>{{end}}</div>
<p class="hint">{{.Cmd.Summary}}</p>
<div><div class="cmdlabel">Runs</div><div class="cmd"><code>{{.Cmd.Display}}</code><button type="button" data-copy="{{.Cmd.Script}}">Copy script</button></div>
  <p class="hint">The script saves the config{{if .Cmd.Dirs}}, creates the directory{{end}} and runs the command, as Create does.</p></div>
{{template "act-callouts" .}}
<div><div class="cmdlabel">Config <span class="act-path">{{.Cmd.Config.Path}}</span></div><pre class="term act-yaml">{{.Cmd.Config.Content}}</pre></div>
{{end}}
{{end}}

{{/* act-nodes is the picker of the nodes of a cluster. */}}
{{define "act-nodes"}}<div class="fld"><span class="lbl">Nodes of {{.Cluster}}</span>
  {{if .Nodes}}<div class="checks act-nodes">{{range .Nodes}}<label><input type="checkbox" name="nodes" value="{{.Short}}"{{if .On}} checked{{end}}> <span class="mono">{{.Short}}</span> <small>{{.Role}}, {{.State}}</small></label>{{end}}</div>
  {{else}}<div class="empty">sind ui sees no node of {{.Cluster}} yet.</div>{{end}}</div>{{end}}

{{define "act-dlg-create-cluster"}}
<div class="row">
  <div class="fld"><label for="act-name">Name</label><input type="text" id="act-name" name="name" value="{{.Val "name"}}" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="act-err-name act-hint-name">
    <span class="err" id="act-err-name"></span><span class="hint" id="act-hint-name">Lowercase letters, digits and -. 1 to 63 characters, 40 with a db node. Not ssh.</span></div>
  <div class="fld act-wide"><label for="act-image">Image</label><input type="text" id="act-image" name="image" value="{{.Val "image"}}" autocapitalize="off" spellcheck="false" aria-describedby="act-err-image act-hint-image">
    <span class="err" id="act-err-image"></span><span class="hint" id="act-hint-image">The Slurm release of the image is the cluster's.</span></div>
</div>
<div class="fld"><span class="lbl">Nodes</span>
<div class="act-roles">
  <div class="act-nr"><span></span><i class="act-sq controller"></i><span class="act-lab"><b>controller</b><span class="hint">slurmctld. Every cluster has one.</span></span><span class="act-always">always</span></div>
  {{range .Roles}}<label class="act-nr{{if .Sub}} sub{{end}}"><input type="checkbox" id="act-{{.Name}}" name="{{.Name}}"{{if $.On .Name}} checked{{end}} aria-describedby="act-err-{{.Name}}"><i class="act-sq {{.Name}}"></i><span class="act-lab"><b>{{.Label}}{{with .Small}} <small>{{.}}</small>{{end}}</b><span class="hint">{{.Hint}}</span><span class="err" id="act-err-{{.Name}}"></span></span></label>
  {{end}}<div class="act-nr"><span></span><i class="act-sq worker"></i><label class="act-lab" for="act-workers"><b>workers</b><span class="hint">Run slurmd. 1 to 64.</span><span class="err" id="act-err-workers"></span></label>
    <span class="act-step"><button type="button" data-act-step="workers" data-d="-1" aria-label="Fewer workers">−</button><input type="number" id="act-workers" name="workers" value="{{.Val "workers"}}" min="1" max="64" aria-describedby="act-err-workers"><button type="button" data-act-step="workers" data-d="1" aria-label="More workers">+</button></span></div>
</div></div>
<label class="act-nr act-box"><input type="checkbox" id="act-monitoring" name="monitoring"{{if .On "monitoring"}} checked{{end}} aria-describedby="act-err-monitoring"><span class="act-lab"><b>Monitoring</b><span class="hint">Adds the nodes to the realm's Prometheus, Loki and Grafana. Needs Slurm 26.05 or later in the image.</span><span class="err" id="act-err-monitoring"></span></span></label>
<div class="row">
  <div class="fld"><label for="act-cpus">CPUs per node</label><input type="number" id="act-cpus" name="cpus" value="{{.Val "cpus"}}" min="1" max="64" aria-describedby="act-err-cpus"><span class="err" id="act-err-cpus"></span></div>
  <div class="fld"><label for="act-memory">Memory per node</label><input type="text" id="act-memory" name="memory" value="{{.Val "memory"}}" list="act-memories" autocapitalize="off" spellcheck="false" aria-describedby="act-err-memory act-hint-memory">
    <datalist id="act-memories">{{range .Memories}}<option value="{{.}}"></option>{{end}}</datalist><span class="err" id="act-err-memory"></span><span class="hint" id="act-hint-memory">Such as 512m, 2g or 1.5g.</span></div>
  <div class="fld"><label for="act-users">Users</label><input type="text" id="act-users" name="users" value="{{.Val "users"}}" placeholder="none" autocapitalize="off" spellcheck="false" aria-describedby="act-err-users act-hint-users">
    <span class="err" id="act-err-users"></span><span class="hint" id="act-hint-users">sind creates them on every node, with a home.</span></div>
</div>
<details class="act-sec" id="act-sec-data"><summary><span class="act-st">Data</span><span class="act-ss" id="act-sum-data"></span><span class="act-sb" id="act-bad-data"></span></summary>
  <div class="act-sbody">
    <div class="seg act-seg" role="radiogroup" aria-label="Data storage">
      <label><input type="radio" id="act-dtype" name="dtype" value="hostPath"{{if ne (.Val "dtype") "volume"}} checked{{end}}><span>Host directory</span></label><label><input type="radio" id="act-dtype-volume" name="dtype" value="volume"{{if eq (.Val "dtype") "volume"}} checked{{end}}><span>Docker volume</span></label></div>
    <span class="err" id="act-err-dtype"></span>
    <div class="row">
      <div class="fld act-wide"><label for="act-dir">Directory</label><input type="text" id="act-dir" name="dir" value="{{.Val "dir"}}" autocapitalize="off" spellcheck="false"{{if .DirFollows}} data-act-follow{{end}}{{if eq (.Val "dtype") "volume"}} readonly{{end}} aria-describedby="act-err-dir act-hint-dir">
        <span class="err" id="act-err-dir"></span><span class="hint" id="act-hint-dir">On the host. Jobs write here as root.</span></div>
      <div class="fld"><label for="act-mount">Mount path</label><input type="text" id="act-mount" name="mount" value="{{.Val "mount"}}" placeholder="/data" autocapitalize="off" spellcheck="false" aria-describedby="act-err-mount act-hint-mount">
        <span class="err" id="act-err-mount"></span><span class="hint" id="act-hint-mount">In the nodes.</span></div>
    </div>
    <label class="act-nr act-box"><input type="checkbox" id="act-mkdir" name="mkdir"{{if .On "mkdir"}} checked{{end}} aria-describedby="act-err-mkdir"><span class="act-lab"><b>Create the directory if it is missing</b><span class="hint">Docker mounts only a directory that exists.</span><span class="err" id="act-err-mkdir"></span></span></label>
    <span class="hint">sind ui writes the data storage into the config, so the saved file alone makes the same cluster again.</span>
  </div>
</details>
<details class="act-sec" id="act-sec-run"><summary><span class="act-st">Run options</span><span class="act-ss" id="act-sum-run"></span><span class="act-sb" id="act-bad-run"></span></summary>
  <div class="act-sbody">
    {{if .Val "pull_auto"}}<input type="hidden" id="act-pull-auto" name="pull_auto" value="1">{{end}}
    <label class="act-nr act-box"><input type="checkbox" id="act-pull" name="pull"{{if .On "pull"}} checked{{end}} aria-describedby="act-err-pull act-pull-hint"><span class="act-lab"><b>Pull the image</b><span class="hint" id="act-pull-hint">Gets the newest image first, even if Docker has one.</span><span class="err" id="act-err-pull"></span></span></label>
    <div class="fld"><span class="lbl" id="act-wait-lbl">Wait for ready</span>
      <div class="act-waits"><div class="seg act-seg" role="radiogroup" aria-labelledby="act-wait-lbl">{{range .Waits}}<label><input type="radio" name="wait" value="{{.Value}}"{{if $.Is "wait" .Value}} checked{{end}}{{if eq .Value "2m"}} id="act-wait"{{end}}><span>{{.Label}}</span></label>{{end}}</div>
      <input type="text" id="act-wait_other" name="wait_other" value="{{.Val "wait_other"}}" placeholder="such as 15m" autocapitalize="off" spellcheck="false" aria-label="Other time to wait" aria-describedby="act-err-wait_other"></div>
      <span class="err" id="act-err-wait"></span><span class="err" id="act-err-wait_other"></span>
      <span class="hint">For each node, from the start of its container; pulls do not count. If a node is not ready in time, sind removes the cluster again.</span></div>
  </div>
</details>
{{end}}

{{define "act-dlg-create-worker"}}
<div class="row">
  <div class="fld"><label for="act-count">How many</label><input type="number" id="act-count" name="count" value="{{.Val "count"}}" min="1" max="64"></div>
  <div class="fld"><label for="act-cpus">CPUs</label><input type="number" id="act-cpus" name="cpus" value="{{.Val "cpus"}}" placeholder="as the newest worker" min="1" max="64"></div>
  <div class="fld"><label for="act-memory">Memory</label><input type="text" id="act-memory" name="memory" value="{{.Val "memory"}}" placeholder="as the newest worker" autocapitalize="off" spellcheck="false"><span class="hint">Such as 1g or 512m.</span></div>
</div>
{{end}}

{{define "act-dlg-delete-cluster"}}
<div class="callout bad">This cannot be undone. Jobs, accounting and the Slurm state of {{.Cluster}} go with it. A host directory mounted as /data stays as it is; a data volume goes too.</div>
{{end}}

{{define "act-dlg-delete-worker"}}
{{template "act-nodes" .}}
<div class="callout bad">Jobs on these workers fail. This cannot be undone; add workers again to get new ones.</div>
{{end}}

{{define "act-dlg-power"}}
{{template "act-nodes" .}}
<div class="fld"><span class="lbl">What to do</span><div class="checks">
  {{range .Ops}}<label><input type="radio" name="op" value="{{.ID}}"{{if $.Is "op" .ID}} checked{{end}}> <span>{{.Label}} <small>{{.Text}}</small></span></label>{{end}}
</div></div>
{{end}}

{{define "act-dlg-connect"}}
<div class="fld"><label for="act-container">Container</label><input type="text" id="act-container" name="container" value="{{.Val "container"}}" placeholder="kind-control-plane" autocapitalize="off" spellcheck="false"><span class="hint">The name of a running container that no realm has yet.</span></div>
{{end}}

{{define "act-dlg-disconnect"}}
<div class="fld"><label for="act-container">Container</label><input type="text" id="act-container" name="container" value="{{.Val "container"}}" placeholder="kind-control-plane" autocapitalize="off" spellcheck="false"><span class="hint">The name of a container that is connected to realm {{.Realm}}.</span></div>
{{end}}

{{define "act-dlg-delete-realm"}}
<div class="callout bad">This cannot be undone.</div>
{{end}}
