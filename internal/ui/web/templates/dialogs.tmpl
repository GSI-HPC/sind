{{/*
  Dialogs of the actions. A page opens one with
  <button hx-get="/dialogs/ID?realm=R&cluster=C" hx-target="#layer">: the
  answer is "act-dialog", which fills the layer of the layout. The form asks
  /actions/ID/preview for the command as it changes, and runs it with
  /actions/ID/run. A dialog shows the command it runs; it never sends one.
  The views are the *View of the request; the dialog or the preview is its
  Data. act.js makes the page behind a dialog inert, asks before a close
  loses changes, and keeps the draft of a dialog with data-act-draft.
*/}}

{{/* "act-dialog" is also the content of a dialog shown as a page of its
own. A dialog ignores the morph extension of the page, which it then sits
in: with it, htmx would put each element that hx-swap-oob="innerHTML" swaps
into its target, not its content. */}}
{{define "act-dialog"}}{{template "act-frame" .Data}}{{end}}

{{define "act-frame"}}
<div class="scrim" id="act-dialog" hx-ext="ignore:morph"{{if not .Spec.Draft}} data-act-scrim{{end}}>
<form class="modal{{if .Spec.Wide}} wide{{end}}" autocomplete="off" role="dialog" aria-modal="true" aria-labelledby="act-title" aria-describedby="act-lead" tabindex="-1"
  {{- if .Spec.Draft}} data-act-draft="{{.ID}}"{{end}}{{if .Draft}} data-act-restored{{end}}
  hx-post="/actions/{{.ID}}/run" hx-target="#act-preview" hx-swap="innerHTML">
  {{template "csrf-field" .View}}
  {{if not .Spec.RealmField}}<input type="hidden" name="realm" value="{{.Realm}}">{{end}}{{if .Cluster}}<input type="hidden" name="cluster" value="{{.Cluster}}">{{end}}
  <div class="mh"><div class="mtop"><h2 id="act-title">{{.Title}}</h2><button type="button" class="iconbtn" data-help-open="{{.ID}}" aria-label="Help for this dialog" title="Help for this dialog">?</button></div>
    <p id="act-lead">{{.Lead}}</p></div>
  {{if .Draft}}<div class="callout act-draftbar"><span>This is your draft from before.</span><button type="button" class="btn sm" data-act-restart>Start over</button></div>{{end}}
  <div class="mb">
    {{include (print "act-dlg-" .ID) .}}
    {{template "act-preview-slot" .}}
  </div>
  <div class="mf" id="act-mf"><span class="act-status" id="act-status"></span><span class="act-checking" id="act-checking" aria-hidden="true">Checking…</span>
    {{- if .Confirms}}<div class="act-confirm"><label for="act-confirm">Type <b class="mono" id="act-confirm-word">{{.Typed}}</b>{{template "act-confirm-what" .}} to confirm</label>
      <input type="text" id="act-confirm" name="confirm" placeholder=" " autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" aria-describedby="act-why"></div>{{end -}}
    <button type="button" class="btn" data-act-close>Cancel</button>{{template "act-ok" .OKButton}}
    {{- if .Confirms}}<span class="hint act-why" id="act-why" role="status"></span>{{end}}</div>
  <div class="mf act-ask" id="act-ask" role="group" aria-labelledby="act-ask-q" hidden>
    <span class="act-askq" id="act-ask-q"><span class="pill warn nodot">Unsaved</span> <span data-act-ask="close">Close and lose your changes<span data-act-ask-of hidden> to <b class="mono" data-act-ask-name></b></span>?</span><span data-act-ask="restart" hidden>Start over and lose your changes?</span></span>
    <button type="button" class="btn" data-act-keep>Keep editing</button><button type="button" class="btn danger solid" data-act-discard>Discard</button>
  </div>
</form>
</div>
{{end}}

{{/* act-confirm-what says what the typed word is, as in "Type 3, the number
of workers, to confirm". */}}
{{define "act-confirm-what"}}<span id="act-confirm-what">{{with .TypedWhat}}, {{.}},{{end}}</span>{{end}}

{{/* act-ok is the button that runs the command, an actOK. It is off until
a preview says that the command can run, and each preview swaps it.
Ctrl+Enter, or Cmd+Enter on macOS, presses it. */}}
{{define "act-ok"}}<button type="submit" class="btn {{if .Danger}}danger solid{{else}}primary{{end}}" id="act-ok" aria-keyshortcuts="Control+Enter Meta+Enter"{{if .Swap}} hx-swap-oob="true"{{end}}{{if .Off}} disabled{{end}}{{if .Why}} aria-describedby="act-why"{{end}}><span class="act-okl">{{.Label}}</span><kbd class="act-kbd" aria-hidden="true"><span class="act-k-ctrl">Ctrl</span><span class="act-k-cmd">⌘</span> ↵</kbd></button>{{end}}

{{define "act-preview-slot"}}<div id="act-preview" class="stack" hx-post="/actions/{{.ID}}/preview" hx-target="this" hx-swap="innerHTML"
      hx-trigger="load, input from:closest form delay:150ms, change from:closest form"{{if not .Spec.Plan}} hx-indicator="#act-checking"{{end}}></div>{{end}}

{{/* act-preview is the answer to a preview: the command, what to know about
it, and the button and the parts of the dialog that depend on it. */}}
{{define "act-preview"}}{{with .Data}}{{$p := .}}
{{if .Shown}}<input type="hidden" name="shown" value="{{.Shown}}">{{end}}
{{if .Spec.Plan}}{{template "act-plan" .}}{{else}}
{{if .ErrAtField}}<p class="hint act-missing">Fix the field above to see the command.</p>{{else if .Err}}<div class="callout bad">{{.Err}}</div>{{else if .Hint}}{{/* the footer says what the form lacks */}}{{else}}
{{with .Cmd.Summary}}<p class="act-sum">{{.}}</p>{{end}}
{{if .Cmd.Budget}}{{template "act-budget" .}}{{end}}
{{with .Cmd.Problems}}<div class="callout bad act-probs" id="act-probs" tabindex="-1"><b>{{$p.ProblemsText}}</b><ul>{{range .}}<li>{{if .Field}}<a href="#act-{{.Field}}" data-act-jump="{{.Field}}">{{.Label}}</a>{{else}}<b>{{.Label}}</b>{{end}}: {{.Text}}</li>{{end}}</ul></div>{{end}}
{{with .Defaulted}}<p class="hint">The command takes the defaults for {{.}} until you fix them.</p>{{end}}
{{if .Cmd.Losses}}{{template "act-losses" .}}
{{else if .Cmd.Goes}}<div class="act-gs"><div class="callout bad act-list"><b>Goes</b><ul>{{range .Cmd.Goes}}<li>{{.}}</li>{{end}}</ul></div>
{{with .Cmd.Stays}}<div class="callout act-list"><b>Stays</b><ul>{{range .}}<li>{{.}}</li>{{end}}</ul></div>{{end}}</div>
{{else}}{{with .Cmd.Stays}}<ul class="act-stays" aria-label="What stays">{{range .}}<li><span class="pg-ck y" aria-hidden="true">✓</span><span>{{.}}</span></li>{{end}}</ul>{{end}}{{end}}
{{template "act-callouts" .}}
<div><div class="cmdlabel">Runs</div><div class="cmd"><code class="nop act-cls">{{range .CmdLines}}<span class="act-cl">{{range $i, $w := .}}{{if $i}} {{end}}<span class="act-cw">{{$w}}</span>{{end}}</span>{{end}}</code><button type="button" data-pg-copy-text="{{.Cmd.Display}}">Copy</button></div></div>
{{if .Cmd.Ack}}<label class="callout bad act-ack"><input type="checkbox" id="act-ack" name="ack" data-act-hold{{if eq (.Form.Get "ack") "on"}} checked{{end}}><span>{{range .AckParts}}{{if .Mono}}<b class="mono">{{.Text}}</b>{{else}}{{.Text}}{{end}}{{end}}</span></label>{{end}}
{{end}}
{{if or .Err .Hint}}{{template "act-callouts" .}}{{end}}
{{if .Confirms}}<b class="mono" id="act-confirm-word" hx-swap-oob="true">{{.Typed}}</b><span id="act-confirm-what" hx-swap-oob="true">{{with .TypedWhat}}, {{.}},{{end}}</span><span id="act-why" hx-swap-oob="innerHTML">{{.Why}}</span>{{end}}
{{end}}
{{template "act-ok" .OKButton}}
{{range .Fields}}<span class="err" id="act-err-{{.}}" hx-swap-oob="innerHTML">{{$p.ProblemOf .}}</span>{{end}}
{{if .Spec.Plan}}{{template "act-page-oob" .}}{{range .NodeViews}}<span id="act-chip-{{.Key}}"{{if .Own}} class="own"{{end}} hx-swap-oob="true">{{.Chip}}</span>{{if .Group}}<span id="act-range-{{.Key}}" hx-swap-oob="innerHTML">{{$p.RangeOf .Key}}</span>{{end}}{{end}}
{{with .Eff}}<span id="act-eff" hidden hx-swap-oob="true" data-image="{{.Image}}" data-cpus="{{.CPUs}}" data-memory="{{.Memory}}" data-tmp="{{.TmpSize}}"></span>{{end}}
<span class="hint" id="act-pull-hint" data-act-pull="{{if .PullOn}}on{{else}}off{{end}}" hx-swap-oob="true">{{.PullHint}}</span>
<datalist id="act-dl-groups" hx-swap-oob="true">{{range .GroupNames}}<option value="{{.}}"></option>{{end}}</datalist><datalist id="act-dl-accounts" hx-swap-oob="true">{{range .AccountNames}}<option value="{{.}}"></option>{{end}}</datalist>
{{range .SlurmFiles}}<span class="act-dot" id="act-dot-{{.ID}}" hx-swap-oob="true">{{if $p.SlurmSet .ID}} •{{end}}</span>{{end}}
{{range .Sections}}{{if .Summary}}<span class="act-ss" id="act-sum-{{.ID}}" hx-swap-oob="innerHTML">{{.Summary}}</span>{{end}}<span class="act-sb" id="act-bad-{{.ID}}" hx-swap-oob="innerHTML">{{with .Bad}}{{.}} problem{{if ne . 1}}s{{end}}{{end}}</span>{{end}}{{end}}
{{with .Head}}<h2 id="act-title" hx-swap-oob="true">{{.Title}}</h2><p id="act-lead" hx-swap-oob="true">{{.Lead}}</p>{{end}}
{{if eq .ID "power"}}{{with .PowerOffs}}<p class="hint act-offs" id="act-offs" hx-swap-oob="true">{{.}}</p>{{else}}<p class="hint act-offs" id="act-offs" hx-swap-oob="true" hidden></p>{{end}}{{end}}
<span class="act-status" id="act-status" hx-swap-oob="innerHTML">{{if .Spec.Plan}}{{template "act-pstatus" .}}{{else}}{{template "act-fstatus" .}}{{end}}</span>
{{end}}{{end}}

{{/* act-losses is what a delete of clusters or of a realm removes and
keeps, a row for each cluster and one for a realm that goes with its last
cluster: the data volumes that go first, in red, then the rest that goes,
and what stays, in green; then what else stays. */}}
{{define "act-losses"}}<div class="act-lw"><table class="act-loss"><thead><tr><th>Cluster</th><th>Goes</th><th>Stays</th></tr></thead><tbody>
{{range .Cmd.Losses}}<tr><td class="act-lc"><b class="mono">{{.Name}}</b><small>{{.About}}</small></td>
  <td class="act-lg" data-label="Goes">{{if .Data}}{{range .Data}}<span class="act-lbad">{{.Line}}</span>{{end}}<small>{{.Goes}}</small>{{else}}{{.Goes}}{{end}}</td>
  <td class="act-ls" data-label="Stays">{{range .Stays}}<span class="act-lok">{{.What}}</span>{{with .Note}}<small>{{.}}</small>{{end}}{{else}}<span class="faint">nothing</span>{{end}}</td></tr>
{{end}}</tbody></table></div>
{{with .AlsoStays}}<p class="hint act-also">Also stays: {{.}}</p>{{end}}{{end}}

{{/* act-fstatus is the status in the footer of a dialog without a plan,
beside its button, so that it is always in view: the problems, which lead
to the first, what the form still lacks, or the warnings, which lead to the
first of them; the first problem or warning says itself in short. */}}
{{define "act-fstatus"}}
{{- if .Problems}}<button type="button" class="pill bad nodot act-go" data-act-go="{{.First.Field}}" aria-label="{{.StatusText}}. {{.StatusGo}}." title="{{.StatusGo}}">{{.StatusText}} <span aria-hidden="true">↑</span></button><span class="act-fnote" title="{{.First.Text}}">{{.First.Text}}</span>
{{- else if .Hint}}<span class="hint act-tot">{{.Hint}}</span>
{{- else if .Warnings}}<button type="button" class="pill warn nodot act-go" data-act-go="@warn" aria-label="{{.WarningsText}}. Show them." title="Show the warnings">{{.WarningsText}} <span aria-hidden="true">↑</span></button><span class="act-fnote" title="{{.FirstWarn}}">{{.FirstWarn}}</span>{{end}}{{end}}

{{/* act-budget is what new workers take of the Docker host beside the
nodes that run on it: the memory limits of all of them against the memory
of the host, as a bar of the nodes that run now and the new ones, on which
the host is a mark once they come to more; the number of nodes, the
Doctor's inotify warning once they reach it, and, while the limits come to
more than the host has, the box that adds them anyway. */}}
{{define "act-budget"}}{{$p := .}}{{with .Cmd.Budget}}<div class="act-budget" id="act-budget">
<div class="act-hb{{if .Over}} over{{else if .High}} high{{end}}">
  <div class="act-hbh"><b>Memory of the Docker host</b><span class="mono">{{$p.MemoryLabel .TotalMB}} of {{$p.MemoryLabel .HostMB}}</span></div>
  <svg class="act-hbar" viewBox="0 0 1000 10" preserveAspectRatio="none" aria-hidden="true"><rect class="now" width="{{.NowW}}" height="10"/><rect class="add" x="{{.NowW}}" width="{{.AddW}}" height="10"/>{{if .Over}}<rect class="host" x="{{.HostX}}" width="5" height="10"/>{{end}}</svg>
  <div class="act-hbl hint"><span><i class="act-sw now" aria-hidden="true"></i>the {{$p.NodesText .NowNodes}} that run now: {{$p.MemoryLabel .NowMB}}{{with .Unknown}}, {{$p.NodesText .}} of them of a size sind ui cannot read{{end}}</span>
    <span><i class="act-sw add" aria-hidden="true"></i>the new {{if eq .AddNodes 1}}worker{{else}}workers{{end}}: {{$p.MemoryLabel .AddMB}}{{if .Over}}, more than the host has{{end}}</span></div>
  <div class="act-hbh"><span>Nodes on the host then</span><span class="mono">{{.Nodes}}</span></div></div>
{{range $p.HostWarns}}{{template "act-hostwarn" .}}{{end}}
{{if .Over}}<label class="act-nr act-box"><input type="checkbox" id="act-overcommit" name="overcommit"{{if $p.Form.Get "overcommit"}} checked{{end}} data-act-hold aria-describedby="act-hint-overcommit"><span class="act-lab"><b>Add anyway</b><span class="hint" id="act-hint-overcommit">Docker caps the memory of each node but sets none aside, so idle nodes use less. Jobs that use it all make the host run out of memory.</span></span></label>{{end}}
</div>{{end}}{{end}}

{{/* act-callouts are what to know about the command of a preview. */}}
{{define "act-callouts"}}
{{if .Warn}}<div class="callout warn">{{.Warn}}</div>{{end}}
{{if and .Lock (not .Err)}}<div class="callout warn">Another command holds the lock of realm <b class="mono">{{.Realm}}</b>: <span class="mono">{{.Lock.String}}</span>. {{.LockWaits}}</div>{{end}}
{{range .NoteParts}}<div class="callout">{{range .}}{{if .Mono}}<span class="mono">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}</div>{{end}}
{{range .Cmd.Warns}}<div class="callout warn">{{.}}</div>{{end}}
{{end}}

{{/* act-chip is the size button of a node of a new cluster, which opens
its editor. */}}
{{define "act-chip"}}<button type="button" class="act-cz" data-act-ed="{{.Key}}" aria-expanded="{{if .Own}}true{{else}}false{{end}}" aria-controls="act-ed-{{.Key}}" aria-labelledby="act-czl-{{.Key}}{{if .Group}} act-range-{{.Key}}{{end}} act-chip-{{.Key}}"><span class="vh" id="act-czl-{{.Key}}">Size of {{.Label}}</span>{{template "act-chip-text" .}}</button>{{end}}

{{define "act-chip-text"}}<span id="act-chip-{{.Key}}"{{if .Own}} class="own"{{end}}>{{.Chip}}</span>{{end}}

{{/* act-group is a worker group of a new cluster: its row, which says
what the workers do first and what runs on them second, and its editor. */}}
{{define "act-group"}}<div class="act-nr act-wgrow" id="act-wg-{{.Key}}"><span><input type="hidden" name="wg" value="{{.Key}}"></span><i class="act-sq worker"></i><label class="act-lab" for="act-{{.Key}}-count"><span class="act-purp"><b data-word="worker">{{.Label}}</b> run your jobs <span class="act-d"><span data-word="slurmd">slurmd</span> · <span id="act-range-{{.Key}}">{{.Range}}</span></span></span><span class="err" id="act-err-{{.Key}}-count"></span></label>{{template "act-chip" .}}
  <span class="act-k"><span class="act-step"><button type="button" id="act-{{.Key}}-less" data-act-step="{{.Key}}-count" data-d="-1" aria-label="Fewer in {{.Label}}" aria-labelledby="act-{{.Key}}-less act-range-{{.Key}}">−</button><input type="number" id="act-{{.Key}}-count" name="{{.Key}}-count" value="{{.Val "count"}}" min="1" aria-describedby="act-err-{{.Key}}-count"><button type="button" id="act-{{.Key}}-more" data-act-step="{{.Key}}-count" data-d="1" aria-label="More in {{.Label}}" aria-labelledby="act-{{.Key}}-more act-range-{{.Key}}">+</button></span><button type="button" class="act-x" id="act-{{.Key}}-del" data-act-wgdel="{{.Key}}" aria-label="Remove {{.Label}}" aria-labelledby="act-{{.Key}}-del act-range-{{.Key}}">✕</button></span></div>
{{template "act-ned" .}}{{end}}

{{/* act-ned is the editor of the size and more of a node of a new
cluster. An empty field takes the node defaults, which it shows as its
placeholder. */}}
{{define "act-ned"}}<div class="act-ned" id="act-ed-{{.Key}}"{{if not .Own}} hidden{{end}}>
  <div class="act-edg">
    <div class="fld"><label for="act-{{.Key}}-image">Image</label><input type="text" id="act-{{.Key}}-image" name="{{.Key}}-image" value="{{.Val "image"}}" placeholder="{{.Eff.Image}}" data-act-ph="image" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-image"><span class="err" id="act-err-{{.Key}}-image"></span></div>
    <div class="fld"><label for="act-{{.Key}}-cpus">CPUs</label><input type="number" id="act-{{.Key}}-cpus" name="{{.Key}}-cpus" value="{{.Val "cpus"}}" min="1" placeholder="{{.Eff.CPUs}}" data-act-ph="cpus" aria-describedby="act-err-{{.Key}}-cpus"><span class="err" id="act-err-{{.Key}}-cpus"></span></div>
    <div class="fld"><label for="act-{{.Key}}-memory">Memory</label><input type="text" id="act-{{.Key}}-memory" name="{{.Key}}-memory" value="{{.Val "memory"}}" list="act-memories" placeholder="{{.Eff.Memory}}" data-act-ph="memory" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-memory"><span class="err" id="act-err-{{.Key}}-memory"></span></div>
    <div class="fld"><label for="act-{{.Key}}-tmp">/tmp</label><input type="text" id="act-{{.Key}}-tmp" name="{{.Key}}-tmp" value="{{.Val "tmp"}}" placeholder="{{.Eff.TmpSize}}" data-act-ph="tmp" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-tmp"><span class="err" id="act-err-{{.Key}}-tmp"></span></div>
  </div>
  <div class="act-inline"><span class="hint">Empty fields take the node defaults.{{if eq .Key "controller"}} The backup controller gets the same values.{{end}}</span><button type="button" class="btn sm" data-act-reset="{{.Key}}">Use the defaults</button></div>
  <details class="act-more"><summary>More: managed, capabilities, devices</summary>
    <div class="act-edg">
      {{if .Managed}}<label class="act-nr act-box act-full"><input type="checkbox" id="act-{{.Key}}-unmanaged" name="{{.Key}}-unmanaged"{{if .On "unmanaged"}} checked{{end}} aria-describedby="act-err-{{.Key}}-unmanaged"><span class="act-lab"><b>Unmanaged</b><span class="hint">{{.UnmanagedHint}}</span><span class="err" id="act-err-{{.Key}}-unmanaged"></span></span></label>{{end}}
      {{range .Lists}}<div class="fld"><label for="act-{{$.Key}}-{{.Attr}}">{{.Attr}}</label><input type="text" id="act-{{$.Key}}-{{.Attr}}" name="{{$.Key}}-{{.Attr}}" value="{{$.Val .Attr}}" placeholder="{{.Example}}" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{$.Key}}-{{.Attr}}"><span class="err" id="act-err-{{$.Key}}-{{.Attr}}"></span></div>{{end}}
      <span class="hint act-full">These give the container more rights on the host. They add to those of the node defaults. Separate values with commas.</span>
    </div>
  </details>
</div>{{end}}

{{/* act-user is a row of a user of a new cluster. */}}
{{define "act-user"}}<div class="act-row" id="act-row-{{.Key}}" data-act-row><input type="hidden" name="ur" value="{{.Key}}">
  <div class="act-rowf">
    <input type="text" id="act-{{.Key}}-name" name="{{.Key}}-name" value="{{.Val "name"}}" placeholder="name, such as alice" aria-label="User name" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-name">
    <input type="number" id="act-{{.Key}}-uid" name="{{.Key}}-uid" value="{{.Val "uid"}}" min="1000" placeholder="UID: auto" aria-label="UID" aria-describedby="act-err-{{.Key}}-uid">
    <input type="text" id="act-{{.Key}}-accounts" name="{{.Key}}-accounts" value="{{.Val "accounts"}}" list="act-dl-accounts" placeholder="Slurm accounts" aria-label="Slurm accounts, the first is the default" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-accounts">
    <button type="button" class="act-x" id="act-{{.Key}}-del" data-act-rowdel aria-label="Remove the user" aria-labelledby="act-{{.Key}}-del act-{{.Key}}-name">✕</button>
  </div>
  <span class="err" id="act-err-{{.Key}}-name"></span><span class="err" id="act-err-{{.Key}}-uid"></span><span class="err" id="act-err-{{.Key}}-accounts"></span>
  <details class="act-more"{{if or (.Val "group") (.Val "groups") (.Val "coordinator") (.Val "admin")}} open{{end}}><summary>More: groups, coordinator, admin level</summary>
    <div class="act-edg">
      <div class="fld"><label for="act-{{.Key}}-group">Primary group</label><input type="text" id="act-{{.Key}}-group" name="{{.Key}}-group" value="{{.Val "group"}}" list="act-dl-groups" placeholder="its own" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-group"><span class="err" id="act-err-{{.Key}}-group"></span></div>
      <div class="fld"><label for="act-{{.Key}}-groups">Groups</label><input type="text" id="act-{{.Key}}-groups" name="{{.Key}}-groups" value="{{.Val "groups"}}" list="act-dl-groups" placeholder="none" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-groups"><span class="err" id="act-err-{{.Key}}-groups"></span></div>
      <div class="fld"><label for="act-{{.Key}}-coordinator">Coordinator of</label><input type="text" id="act-{{.Key}}-coordinator" name="{{.Key}}-coordinator" value="{{.Val "coordinator"}}" list="act-dl-accounts" placeholder="no account" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-coordinator"><span class="err" id="act-err-{{.Key}}-coordinator"></span></div>
      <div class="fld"><label for="act-{{.Key}}-admin">Admin level</label><select id="act-{{.Key}}-admin" name="{{.Key}}-admin" aria-describedby="act-err-{{.Key}}-admin">{{$a := .Val "admin"}}<option value=""{{if eq $a ""}} selected{{end}}>None</option><option value="operator"{{if eq $a "operator"}} selected{{end}}>Operator</option><option value="admin"{{if eq $a "admin"}} selected{{end}}>Admin</option></select><span class="err" id="act-err-{{.Key}}-admin"></span></div>
      <span class="hint act-full">Separate groups and accounts with commas. Coordinator and admin level need an account.</span>
    </div>
  </details>
</div>{{end}}

{{/* act-group-row is a row of a group of a new cluster. */}}
{{define "act-group-row"}}<div class="act-row" id="act-row-{{.Key}}" data-act-row><input type="hidden" name="gr" value="{{.Key}}">
  <div class="act-rowf">
    <input type="text" id="act-{{.Key}}-name" name="{{.Key}}-name" value="{{.Val "name"}}" placeholder="name, such as hpc" aria-label="Group name" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-name">
    <input type="number" id="act-{{.Key}}-gid" name="{{.Key}}-gid" value="{{.Val "gid"}}" min="1000" placeholder="GID: auto" aria-label="GID" aria-describedby="act-err-{{.Key}}-gid">
    <button type="button" class="act-x" id="act-{{.Key}}-del" data-act-rowdel aria-label="Remove the group" aria-labelledby="act-{{.Key}}-del act-{{.Key}}-name">✕</button>
  </div>
  <span class="err" id="act-err-{{.Key}}-name"></span><span class="err" id="act-err-{{.Key}}-gid"></span>
</div>{{end}}

{{/* act-account is a row of a Slurm account of a new cluster, with its
limits as pairs of fields. */}}
{{define "act-account"}}<div class="act-row" id="act-row-{{.Key}}" data-act-row><input type="hidden" name="ar" value="{{.Key}}">
  <div class="act-rowf">
    <input type="text" id="act-{{.Key}}-name" name="{{.Key}}-name" value="{{.Val "name"}}" placeholder="name, such as physics" aria-label="Account name" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-name">
    <input type="text" id="act-{{.Key}}-parent" name="{{.Key}}-parent" value="{{.Val "parent"}}" list="act-dl-accounts" placeholder="parent: root" aria-label="Parent account" autocapitalize="off" spellcheck="false" aria-describedby="act-err-{{.Key}}-parent">
    <button type="button" class="act-x" id="act-{{.Key}}-del" data-act-rowdel aria-label="Remove the account" aria-labelledby="act-{{.Key}}-del act-{{.Key}}-name">✕</button>
  </div>
  <span class="err" id="act-err-{{.Key}}-name"></span><span class="err" id="act-err-{{.Key}}-parent"></span>
  <div class="act-lims" id="act-lims-{{.Key}}">{{range .Limits}}{{template "act-limit" .}}{{end}}</div>
  <span class="err" id="act-err-{{.Key}}-lk"></span>
  <button type="button" class="btn sm" data-act-rowadd="limit" data-act-into="act-lims-{{.Key}}" data-act-key="{{.Key}}">+ Add limit</button>
</div>{{end}}

{{/* act-limit is a limit of an account: a pair of fields. The value and the
button are named after the limit, which act.js keeps up as it is typed. */}}
{{define "act-limit"}}<div class="act-rowf act-lim" data-act-row>
  <input type="text" name="{{.Row}}-lk" value="{{.Key}}" list="act-dl-limits" placeholder="limit, such as MaxJobs" aria-label="Limit" autocapitalize="off" spellcheck="false">
  <input type="text" name="{{.Row}}-lv" value="{{.Value}}" placeholder="value, such as 4" aria-label="Value of {{with .Key}}{{.}}{{else}}the limit{{end}}" autocapitalize="off" spellcheck="false" data-act-limname="Value of ">
  <button type="button" class="act-x" data-act-rowdel aria-label="Remove {{with .Key}}{{.}}{{else}}the limit{{end}}" data-act-limname="Remove ">✕</button>
</div>{{end}}

{{/* act-dlg-create-worker adds workers: to the cluster of the link, which
a row names with Change, or, when the link names none, to the cluster that
the user picks first from the list, which opens the dialog again for it
with the fields that the user filled in. */}}
{{define "act-dlg-create-worker"}}
{{if .Picking}}<div class="fld"><span class="lbl" id="act-cl-lbl">Cluster</span>
  <div class="act-cls" role="group" aria-labelledby="act-cl-lbl">{{range .ClusterGroups}}<div class="act-clg" role="group" aria-label="Realm {{.Realm}}"><span class="act-ogl" aria-hidden="true">realm {{.Realm}}</span>
    {{range .Rows}}<button type="button" class="act-crow" hx-get="{{.URL}}" hx-include="#act-count,#act-cpus,#act-memory" hx-target="#layer" hx-swap="innerHTML" data-act-focus{{if .Off}} disabled{{end}}><span class="act-crn"><b class="mono">{{.Name}}</b><small>{{with .Off}}{{.}}{{else}}{{.Workers}}{{end}}</small></span>{{if .Pill.Text}}<span class="pill {{.Pill.Class}}">{{.Pill.Text}}</span>{{end}}</button>{{end}}</div>{{end}}</div>
  <span class="hint">Or open Add workers on the page of a cluster to skip this step.</span></div>
{{else}}{{with .ClusterRow}}<div class="act-target act-ctarget"><span class="act-crn"><span><span class="faint">Cluster</span> <b class="mono">{{.Name}}</b></span><small>realm {{.Realm}} · {{.Workers}}</small></span>{{if .Pill.Text}}<span class="pill {{.Pill.Class}}">{{.Pill.Text}}</span>{{end}}
  {{- if $.CanChange}}<button type="button" class="btn sm" hx-get="{{$.ChangeURL}}" hx-include="#act-count,#act-cpus,#act-memory" hx-target="#layer" hx-swap="innerHTML" aria-label="Change the cluster">Change…</button>{{end}}</div>{{end}}{{end}}
<div class="row">
  <div class="fld"><label for="act-count">How many</label><input type="number" id="act-count" name="count" value="{{.Val "count"}}" min="1"{{if .Picking}} readonly{{end}} aria-describedby="act-err-count"><span class="err" id="act-err-count"></span></div>
  <div class="fld"><label for="act-cpus">CPUs</label><input type="number" id="act-cpus" name="cpus" value="{{.Val "cpus"}}" placeholder="{{if .Picking}}as its newest worker{{else}}{{.LikeNewest}}{{end}}" min="1"{{if .Picking}} readonly{{end}} aria-describedby="act-err-cpus"><span class="err" id="act-err-cpus"></span></div>
  <div class="fld"><label for="act-memory">Memory</label><input type="text" id="act-memory" name="memory" value="{{.Val "memory"}}" placeholder="{{if .Picking}}as its newest worker{{else}}{{.LikeNewest}}{{end}}" autocapitalize="off" spellcheck="false"{{if .Picking}} readonly{{end}} aria-describedby="act-err-memory act-hint-memory"><span class="err" id="act-err-memory"></span><span class="hint" id="act-hint-memory">Such as 1g or 512m.</span></div>
</div>
{{end}}

{{define "act-dlg-delete-cluster"}}{{end}}

{{define "act-dlg-delete-clusters"}}
<input type="hidden" name="back" value="{{.Val "back"}}">
{{if .Clusters}}{{range .Clusters}}<input type="hidden" name="clusters" value="{{.Ref}}">{{end}}
{{with .Gone}}<div class="callout warn">sind ui no longer sees <span class="mono">{{$.GoneText}}</span>, so the dialog leaves {{if eq (len .) 1}}it{{else}}them{{end}} out.</div>{{end}}
{{else}}<div class="empty">{{if .Gone}}sind ui no longer sees <span class="mono">{{.GoneText}}</span>. {{end}}No cluster to delete. Tick clusters on <a href="{{.Back}}">the Clusters page</a> and delete them from the bar above the table.</div>
{{end}}{{end}}

{{define "act-dlg-delete-worker"}}<div class="fld"><span class="lbl">Workers of {{.Cluster}}</span>
{{if .Nodes}}{{template "act-ntable" .}}{{else}}<div class="empty">sind ui sees no worker of {{.Cluster}}.</div>{{end}}</div>
{{end}}

{{/* act-dlg-power is the Power dialog: a short confirmation of the
action and the nodes of its link, whose picker waits behind Change nodes,
or the picker, when the link names no action or no nodes. act.js keeps the
node set field and the ticks in step, and turns off the actions that fit no
ticked node. */}}
{{define "act-dlg-power"}}<div class="act-power" data-act-power>
{{if .Short}}<div class="act-target" data-act-target>
  <ul class="act-tl">{{range .Picked}}{{template "act-node-line" .}}{{end}}</ul>
  <button type="button" class="btn sm" data-act-change aria-controls="act-pick" aria-expanded="false">Change nodes…</button></div>
<details class="act-other" data-act-other><summary><b>Other actions</b><span class="pg-caret" aria-hidden="true"></span> <span class="faint act-otherops">{{.OtherOps}}</span></summary>{{template "act-opseg" .}}</details>
{{else}}{{template "act-opseg" .}}{{end}}
<div class="fld act-reason"><label for="act-reason">Reason for the drain</label><input type="text" id="act-reason" name="reason" value="{{.Val "reason"}}" placeholder="such as disk test" maxlength="200" aria-describedby="act-hint-reason"><span class="hint" id="act-hint-reason">sinfo -R shows it.</span></div>
<div class="act-pick" id="act-pick"{{if .Short}} hidden{{end}}>
{{if .Nodes}}<div class="act-ph2"><label class="lbl" for="act-nodeset">Nodes of {{.Cluster}}</label>
  <span class="act-picks" role="group" aria-label="Tick"><span class="faint">Tick:</span>{{range .Picks}}<button type="button" class="btn sm act-qp" data-act-pick="{{.Nodes}}"{{if not .N}} disabled{{end}}>{{.Label}} <span class="act-qn{{if and .N .Class}} {{.Class}}{{end}}">{{.N}}</span></button>{{end}}</span></div>
<input type="text" id="act-nodeset" value="{{.PickedSet}}" placeholder="such as worker-[0-3]" autocapitalize="off" autocomplete="off" spellcheck="false" aria-describedby="act-nodeset-err act-nodeset-hint" data-act-nodeset>
<span class="err" id="act-nodeset-err" role="status"></span><span class="hint" id="act-nodeset-hint">A node set as the CLI takes it. The ticks follow it, and it follows the ticks.</span>
{{template "act-ntable" .}}
{{else}}<div class="empty">sind ui sees no node of {{.Cluster}} yet.</div>{{end}}
</div></div>
{{end}}

{{/* act-opseg is the action segment of the Power dialog, in groups: the
ops of Slurm, those of the containers, and those that can lose data. */}}
{{define "act-opseg"}}<fieldset class="fld act-opseg"><legend class="lbl">Action</legend>
  <div class="act-opsrow">{{range .OpSegs}}<div class="act-og{{if eq .ID "danger"}} danger{{end}}"><span class="act-ogl" id="act-og-{{.ID}}" aria-hidden="true">{{.Label}}</span><div class="seg act-seg" role="group" aria-labelledby="act-og-{{.ID}}">{{range .Ops}}<label title="{{.Text}}"><input type="radio" name="op" value="{{.ID}}"{{if .On}} checked{{end}}><span>{{.Label}}</span></label>{{end}}</div></div>{{end}}</div>
  <p class="hint act-offs" id="act-offs" hidden></p></fieldset>{{end}}

{{/* act-node-line is a picked node of a short confirmation: its name,
role, state and issues. */}}
{{define "act-node-line"}}{{with .Node}}<li><b class="mono">{{.Short}}</b> <span class="chip {{.RoleClass}}">{{.Role}}</span>{{template "act-node-state" .}}</li>{{end}}{{end}}

{{/* act-node-state is what a node of a picker says of itself: what is
wrong with its container and its services, and its Slurm state with the
reason. */}}
{{define "act-node-state"}}{{if .Life}} <span class="pill run">{{.Pill.Text}}</span>{{else}}{{range .ServiceIssues}} <span class="pill {{.Class}}">{{.Text}}</span>{{end}}{{with .Slurm}} <span class="pill {{$.SlurmClass}}" title="Slurm state">{{.State}}</span>{{with .Reason}} <span class="faint act-why2">{{.}}</span>{{end}}{{end}}{{end}}{{end}}

{{/* act-ntable is the table of the nodes of a picker, whose boxes the
form posts as nodes. */}}
{{define "act-ntable"}}{{$roles := ne .ID "delete-worker"}}<div class="act-nt" role="group" aria-label="Nodes of {{.Cluster}}"><table class="act-ntab"><thead><tr><th><span class="vh">Tick</span></th><th>Node</th>{{if $roles}}<th>Role</th>{{end}}<th>Slurm</th><th>Issues</th></tr></thead><tbody>
{{range .Nodes}}<tr data-act-node="{{.Short}}" data-act-offs="{{.Offs}}"><td><input type="checkbox" name="nodes" value="{{.Short}}" id="act-n-{{.Short}}"{{if .On}} checked{{end}}></td>
  <td class="mono act-nn"><label for="act-n-{{.Short}}"><b>{{.Short}}</b></label></td>{{if $roles}}<td class="act-nrole"><span class="chip {{.Node.RoleClass}}">{{.Role}}</span></td>{{end}}
  {{with .Node}}<td class="act-nslurm">{{if .Life}}<span class="pill run">{{.Pill.Text}}</span>{{else if .Slurm}}<span class="pill {{.SlurmClass}}">{{.Slurm.State}}</span>{{with .Slurm.Reason}} <span class="faint act-why2">{{.}}</span>{{end}}{{else}}<span class="faint">–</span>{{end}}</td>
  <td class="act-nissues">{{if .Life}}<span class="faint">–</span>{{else}}{{range .ServiceIssues}}<span class="pill {{.Class}}">{{.Text}}</span> {{else}}<span class="faint">–</span>{{end}}{{end}}</td>{{end}}</tr>{{end}}
</tbody></table></div>{{end}}

{{define "act-dlg-restart-service"}}{{if .Val "nodes"}}<input type="hidden" name="nodes" value="{{.Val "nodes"}}">
<fieldset class="fld"><legend class="lbl">Service of <span class="mono">{{.Val "nodes"}}</span></legend>
  {{with .NodeServices}}<div class="checks">{{range .}}<label><input type="radio" name="unit" value="{{.Name}}"{{if $.Is "unit" .Name}} checked{{end}}> <span class="mono">{{.Name}}</span> <small>{{.Word}}</small></label>{{end}}</div>
  {{else}}<div class="empty">sind ui has not probed this node yet.</div>{{end}}</fieldset>
{{else}}<div class="fld"><label for="act-nodes">Node</label><select id="act-nodes" name="nodes" hx-get="/dialogs/restart-service" hx-include="closest form" hx-target="#layer" hx-swap="innerHTML" aria-describedby="act-hint-nodes"><option value="">Pick a node</option>{{range .ServiceNodes}}<option value="{{.Short}}">{{.Label}}</option>{{end}}</select><span class="hint" id="act-hint-nodes">A node that runs. The dialog then lists the services that sind checks on it.</span></div>
{{end}}{{end}}

{{/* act-dlg-connect is the Connect dialog: the realms to switch to, each
of which opens the dialog again with the container picked so far, and the containers that sind did not make
and that are not on the mesh of the realm, as a list to pick one from,
those that do not run turned off, and Another name for one that starts
later; without such a container, the field for its name. */}}
{{define "act-dlg-connect"}}
{{with .RealmChoices}}<div class="fld"><span class="lbl" id="act-realms-lbl">Realm</span>
  <div class="seg act-seg act-realms" role="group" aria-labelledby="act-realms-lbl">{{range .}}<button type="button" hx-get="{{.URL}}" hx-include=".act-olist input[name=container], #act-container" hx-target="#layer" hx-swap="innerHTML"{{if .On}} aria-pressed="true" class="on"{{else}} aria-pressed="false"{{end}}>{{.Name}}</button>{{end}}</div></div>{{end}}
{{with .Outsides}}<fieldset class="fld act-outs"><legend class="lbl">Containers that sind did not make</legend>
  <div class="act-olist">{{range .}}<label class="act-orow{{if .Off}} off{{end}}"><input type="radio" name="container" value="{{.Name}}"{{if $.Is "container" .Name}} checked data-act-focus{{end}}{{if .Off}} disabled{{end}}>
    <span class="act-on"><b class="mono">{{.Name}}</b><small>{{.Image}}{{if .Off}} · stopped. Start it first.{{else}}{{with .Networks}} · {{.}}{{end}}{{with .Up}} · {{.}}{{end}}{{end}}</small></span>
    {{- if .Off}}<span class="pill">{{.State}}</span>{{else}}{{with .Also}}<span class="chip">{{.}}</span>{{end}}{{end}}</label>{{end}}
    <div class="act-oother"><label class="act-orow"><input type="radio" name="container" value="" id="act-other-pick"{{if and (not ($.Val "container")) ($.Val "other")}} checked{{end}}>
      <span class="act-on"><b>Another name…</b><small>For a container that starts later.</small></span></label>
      <input type="text" class="act-oname" id="act-container" name="other" value="{{$.Val "other"}}" placeholder="such as kind-control-plane" autocapitalize="off" spellcheck="false" aria-label="Name of the container" aria-describedby="act-err-container"{{if and (not ($.Val "container")) ($.Val "other")}} data-act-focus{{end}}></div></div>
  <span class="err" id="act-err-container"></span></fieldset>
{{else}}<div class="fld"><label for="act-container">Container</label><input type="text" id="act-container" name="other" value="{{.Val "other"}}" placeholder="such as kind-control-plane" autocapitalize="off" spellcheck="false" aria-describedby="act-err-container act-hint-container"><span class="err" id="act-err-container"></span><span class="hint" id="act-hint-container">sind ui sees no container that sind did not make and that is not on the mesh of realm {{.Realm}}. Write the name of one that starts later.</span></div>{{end}}
{{end}}

{{define "act-dlg-disconnect"}}
<div class="fld"><label for="act-container">Container</label><input type="text" id="act-container" name="container" value="{{.Val "container"}}" placeholder="kind-control-plane" autocapitalize="off" spellcheck="false"><span class="hint">The name of a container that is connected to realm {{.Realm}}.</span></div>
{{end}}

{{define "act-dlg-delete-realm"}}{{end}}

