{{/* tasks is the fragment of the task dock: a card for each command that sind
ui started, and for each run that a terminal writes to the event log, and a
bar that sums them up when there are several. The dock shows the first card
only, until Show all opens it (run.js); a card of a command that ended ok
hides by itself at data-hide-at. The cards are built in dock.go. */}}
{{define "tasks"}}{{with .Data}}{{if .Bar}}<div class="dock-bar">{{if .Running}}<span class="spin" aria-hidden="true"></span>{{end}}<span class="dock-sum">{{range $i, $p := .Parts}}{{if $i}} · {{end}}{{if .Strong}}<b>{{.Text}}</b>{{else}}{{.Text}}{{end}}{{end}}</span>
  {{if .Clear}}<form class="inline" method="post" action="/tasks/clear" hx-post="/tasks/clear" hx-swap="none">{{template "csrf-field" $}}<button type="submit" class="btn sm">Clear done</button></form>{{end}}{{if .Toggle}}<button type="button" class="btn sm" data-dock-toggle aria-controls="tasks" aria-expanded="false">Show all</button>{{end}}</div>
{{end}}{{range .Cards}}<div class="task {{.Class}}"{{if .HideAt}} data-hide-at="{{.HideAt}}"{{end}}>{{template "run-say" .}}
  <div class="th">{{if eq .Class "running"}}<span class="spin" aria-hidden="true"></span>{{else}}<span class="mark {{.Class}}" aria-hidden="true">{{.Mark}}</span>{{end}}<b><a href="{{.Href}}" title="{{or .Tip .Title}}">{{.Title}}</a></b>{{with .Realm}}<span class="chip" title="realm">{{.}}</span>{{end}}{{with .Chip}}<span class="chip">{{.}}</span>{{end}}
    {{if .Dismiss}}<form class="inline" method="post" action="/tasks/{{.TaskID}}/dismiss" hx-post="/tasks/{{.TaskID}}/dismiss" hx-swap="none">{{template "csrf-field" $}}<button type="submit" class="iconbtn" aria-label="Hide the card of {{.Title}}" title="Hide">×</button></form>{{end}}</div>
  {{template "run-segbar" .}}
  <div class="tl"><span>{{.Line}}</span>{{template "run-elapsed" .}}</div>
  {{if .Err}}<div class="callout bad">{{.Err}}</div>{{end}}
  {{if .Output}}{{if eq .Class "failed"}}<pre class="term tout">{{.Output}}</pre>{{end}}{{end}}
  <div class="tf">{{if .Cancel}}<form class="inline" method="post" action="/tasks/{{.TaskID}}/cancel" hx-post="/tasks/{{.TaskID}}/cancel" hx-swap="none" hx-confirm="Stop this command? sind stops it and removes what it made so far.">{{template "csrf-field" $}}<button type="submit" class="btn sm">Stop</button></form>{{end}}{{if .Canceling}}<button type="button" class="btn sm" disabled>Stopping…</button>{{end}}<a class="btn sm{{if eq .Class "running"}} primary{{end}}" href="{{.Href}}" aria-label="{{.Action}}: {{.Title}}">{{.Action}}</a></div>
</div>
{{end}}{{if .More}}<a class="task more" href="/activity">{{.More}} more in Activity</a>{{end}}{{end}}{{end}}

{{/* run-segbar draws the bar of a run's steps, .Segs, as a progressbar
named after .Title. */}}
{{define "run-segbar"}}<div class="segbar" role="progressbar" aria-label="Progress of {{.Title}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{.Segs.Pct}}" aria-valuetext="{{.Segs.Pct}} %, {{.Segs.Text}}">{{range .Segs}}<i class="{{.Class}}" title="{{.Title}}">{{if .Fill}}<b class="w{{.Fill}}"></b>{{end}}</i>{{end}}</div>{{end}}

{{/* run-say marks what run.js announces in #say: the sentence data-say,
once, when the state of the command data-say-key changes. A command that
started less than a few seconds before data-say-since is announced when its
page opens. */}}
{{define "run-say"}}<span hidden data-say-key="{{.SayKey}}" data-say-state="{{.SayState}}" data-say="{{.Say}}"{{if .Since}} data-say-since="{{.Since}}"{{end}}></span>{{end}}

{{/* run-elapsed is a clock: run.js counts it up while data-since is set. */}}
{{define "run-elapsed"}}<span class="num"{{if .Since}} data-since="{{.Since}}"{{end}}>{{.Elapsed}}</span>{{end}}
