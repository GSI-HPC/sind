{{/* more-top is what a page of the "more" part says above its data, from
its .Data: the callout when Docker is not reachable, as the data may be
stale, and the notice when there is no realm to show. */}}
{{define "more-top"}}{{with .DockerErr}}<div class="callout warn">Docker is not reachable: {{.}}. The page shows what was read last. <a href="/doctor">Open Doctor</a></div>{{end}}
{{with .Notice}}{{if .Text}}<section class="panel"><div class="empty">{{.Text}}{{if .Href}} <a href="{{.Href}}">{{.HrefText}}</a>{{end}}</div></section>{{end}}{{end}}{{end}}
