{{/* slot-jump is the jump box's button in the top bar, and the markup of the
box, which help.js copies into #layer when it opens. */}}
{{define "slot-jump"}}<button type="button" class="jump" data-palette-open aria-label="Jump to"><span>Jump to a cluster, node, page or help</span><kbd>/</kbd></button>
<template id="help-jump-shell"><div class="palette" id="jump"><div class="box" role="dialog" aria-label="Jump to"><input type="text" id="jump-q" placeholder="Jump to… (start with ? for help only)" aria-label="Jump to" role="combobox" aria-expanded="true" aria-controls="jump-list" autocomplete="off" spellcheck="false"><div class="pl" id="jump-list" role="listbox"></div></div></div></template>{{end}}

{{/* help-jump-list is the list of the jump box: .Data is a *jumpData. */}}
{{define "help-jump-list"}}{{with .Data}}{{range .Items}}{{if .Topic}}<a class="pi" role="option" href="/help?topic={{.Topic}}" data-help-topic="{{.Topic}}">{{.Label}}<small>{{.Kind}}</small></a>{{else}}<a class="pi" role="option" href="{{.Href}}">{{.Label}}<small>{{.Kind}}</small></a>{{end}}{{else}}<div class="empty">{{if .HelpOnly}}Nothing in help matches.{{else}}Nothing matches. Start with ? to search help only.{{end}}</div>{{end}}{{end}}{{end}}
