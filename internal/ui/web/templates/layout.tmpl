{{/* layout is the shell of every page: top bar, rail, content, task dock. The
content is the block that .Content names; the rail and the two parts of the
dock, its button and list in the top bar (#cmds) and its strip below the
content (#tasks), are fragments. The slots in the top bar are blocks of
their own files, which the parts that fill them replace as a whole. app.js
fills #conn when the live updates stop. #say is the one live region, for
screen readers: app.js puts in it what a live update changed, and run.js a
sentence when a command starts or ends, which the list of the dock and the
run pages mark with data-say-key and data-say-state (see "run-say").
data-now is the time of the server, which run.js counts the clocks of runs
by. */}}

{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="htmx-config" content='{{.HTMXConfig}}'>
<title>{{if .Title}}{{.Title}} · {{end}}sind ui</title>
<link rel="icon" type="image/svg+xml" href="{{call .Asset "icon.svg"}}">
<link rel="stylesheet" href="{{call .Asset "app.css"}}">
{{range .Styles}}<link rel="stylesheet" href="{{.}}">
{{end}}<script src="{{call .Asset "app.js"}}"></script>
<script src="{{call .Vendor "htmx.min.js"}}" defer></script>
<script src="{{call .Vendor "htmx-ext-sse.js"}}" defer></script>
<script src="{{call .Vendor "idiomorph-ext.min.js"}}" defer></script>
{{range .Scripts}}<script src="{{.}}" defer></script>
{{end}}</head>
<body data-now="{{.Now.UnixMilli}}" hx-headers='{"X-Sind-CSRF":"{{.CSRF}}"}'>
<a class="skip" href="#main">Skip to content</a>
<div class="app"{{if .Events}} hx-ext="sse,morph" sse-connect="{{.Events}}"{{end}}>
  <div class="conn" id="conn" role="status"></div>
  <header class="top">
    <a class="brand" href="/"><img src="{{call .Asset "icon.svg"}}" alt="" width="24" height="24">sind <small>ui</small></a>
    {{template "slot-jump" .}}
    <div class="spacer"></div>
    <div class="cmds" id="cmds" hx-swap="morph:innerHTML" sse-swap="tasks-menu" data-own-focus>{{fragment "tasks-menu" .}}</div>
    {{if .Events}}<span class="live" id="live" title="Live: changes show as they happen"><i></i><span>live</span></span>{{end}}
    <span class="hostchip"><i></i>{{.Addr}}</span>
    {{template "slot-help" .}}
    <button type="button" class="iconbtn" data-theme-toggle aria-label="Dark theme" aria-pressed="false" title="Dark theme">◐</button>
  </header>
  <nav class="rail" id="rail" aria-label="Pages" hx-swap="morph:innerHTML" sse-swap="rail">{{fragment "rail" .}}</nav>
  <main class="main" id="main" tabindex="-1">{{include .Content .}}</main>
  <div class="tasks" id="tasks" hx-swap="morph:innerHTML" sse-swap="tasks">{{fragment "tasks" .}}</div>
</div>
<div class="vh" id="say" role="status"></div>
<div id="layer"></div>
</body>
</html>
{{end}}

{{/* csrf-field is the hidden field of a form that a browser sends without script. */}}
{{define "csrf-field"}}<input type="hidden" name="csrf" value="{{.CSRF}}">{{end}}
