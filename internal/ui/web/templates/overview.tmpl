{{/* page-overview is the Overview page: what needs the user first, when
anything does, then the fleet table of the clusters by realm, and the latest
runs. Each part is a fragment. */}}
{{define "page-overview"}}
<div hx-swap="morph:innerHTML" sse-swap="pg-overview-head">{{fragment "pg-overview-head" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="pg-overview-needs">{{fragment "pg-overview-needs" .}}</div>
<div class="pg-block" hx-swap="morph:innerHTML" sse-swap="pg-overview-cards">{{fragment "pg-overview-cards" .}}</div>
<div class="pg-block" hx-swap="morph:innerHTML" sse-swap="pg-overview-recent">{{fragment "pg-overview-recent" .}}</div>
{{end}}

{{define "pg-overview-head"}}{{with .Data}}
<div class="head"><div class="t"><h1>Overview</h1>
  <div class="sub"><span>{{.RealmsText}}</span>{{template "pg-realm-scope" $}}
    <span>{{.ClustersText}} · {{.NodesText}}</span>
    {{with .Summary}}<a class="pill {{$.Data.SummaryClass}} nodot pg-sumpill" href="#needs">{{.}} <span aria-hidden="true">→</span></a>{{else}}{{if not .Open}}{{if not .Empty}}<span class="pill ok">Nothing needs you</span>{{end}}{{end}}{{end}}</div></div>
  <div class="actions">{{range .Actions}}{{template "pg-action" .}}{{end}}</div></div>
{{end}}{{template "pg-docker-note" .}}{{end}}

{{/* pg-overview-cards is the fleet table: one table of every cluster,
grouped by realm, with the chips that keep the clusters that need a look or
that a command makes. A realm row says what the realm holds and how it is,
with its mesh, a link to Mesh and DNS and its ⋯ menu; a cluster row whether
it is ready for jobs, its nodes as tiles, what is wrong in words or how far
the command that creates or deletes it got, its Slurm and its ⋯ menu. The
column heads and the legend of the tiles show while a cluster row does. In a
narrow panel each realm row is a heading and each cluster a card. */}}
{{define "pg-overview-cards"}}{{with .Data}}{{$d := .}}
{{if .Empty}}{{template "pg-first-steps" .}}{{else}}
<section class="panel pg-fleet" id="fleet" tabindex="-1" aria-labelledby="pg-fleet-h"><div class="ph"><h2 id="pg-fleet-h">Clusters</h2>{{if .Clusters}}<div class="pg-chips" role="group" aria-label="Show">{{template "pg-list-chips" .}}</div>{{end}}<span class="grow"></span><span class="faint pg-fleet-note">a <span data-word="realm">realm</span> keeps its clusters apart</span><a class="btn sm ghost" href="{{.ClustersLink}}">All clusters <span aria-hidden="true">→</span></a></div>
  <div class="tw"><table class="pg-fleet-t">{{if .Shown}}<thead><tr><th scope="col">Cluster</th><th scope="col">Ready for jobs</th><th scope="col">Nodes</th><th scope="col">Issues and progress</th><th scope="col">Slurm</th><th scope="col"><span class="vh">Actions</span></th></tr></thead>{{end}}
  {{range .Fleet}}<tbody>
  <tr class="pg-fr"><th colspan="5" scope="rowgroup"><span class="pg-frh"><a class="mono pg-frn" href="/?realm={{.Name}}"><span class="pg-frw">realm</span> <b>{{.Name}}</b></a><span class="pg-frm">{{.MetaText}}</span>{{range .Lives}}<span class="pill {{.Class}}">{{.Text}}</span>{{end}}{{if .Look}}<span class="pill {{.LookClass}}">{{.LookText}}</span>{{else if .Lives}}{{else if .Nodes}}<span class="pill ok">all running</span>{{end}}{{if and .Locked (not .Lives)}}<span class="pill run">a command runs</span>{{end}}{{with .MeshErr}}<span class="pill warn" title="{{.}}">mesh needs a look<span class="vh">: {{.}}</span></span>{{end}}<a class="pg-frl" href="/mesh?realm={{.Name}}">Mesh and DNS<span class="vh"> of {{.Name}}</span></a></span></th>
    <td class="act">{{template "pg-menu" .Menu}}</td></tr>
  {{range .Rows}}{{$r := .}}<tr class="click pg-fc" data-href="{{.Link}}"><td class="c-name"><a href="{{.Link}}"><b>{{.Name}}</b></a></td>
    <td class="c-ready"><span class="pill{{with .Ready.Class}} {{.}}{{end}}">{{.Ready.Text}}</span>{{with .ReadyText}}<span class="pg-fsub">{{.}}</span>{{end}}</td>
    <td class="c-map"><div class="pg-nodemap" role="group" aria-label="Nodes of {{.Name}}">{{range .Nodes}}{{template "pg-tile" .}}{{end}}</div></td>
    <td class="c-issues">{{with .Life}}<div class="pg-fnow"><div class="pg-lifebar">{{template "run-segbar" .}}</div>{{with $r.Now}}<span class="pg-fis">{{with $r.NowNode}}<b class="mono">{{.}}</b> {{end}}{{.}}</span>{{end}}</div>{{else}}{{range .Issues}}<div class="pg-fis"><a class="mono" href="{{.Node.Link}}">{{.Node.Short}}</a> {{.Text}}</div>{{end}}{{with .More}}<div class="pg-fis faint">{{.}}</div>{{end}}{{with .Note}}<div class="pg-fis">{{.}}</div>{{end}}{{range .Runs}}<div class="pg-fis"><span class="mono">{{.Title}}</span> runs now</div>{{end}}{{if not (or .Issues .Note .Runs)}}<span class="faint pg-fnil">–</span>{{end}}{{end}}</td>
    <td class="c-slurm"><span class="mono">{{.Slurm}}</span>{{if .Monitoring}} <span class="chip brand">monitoring</span>{{end}}</td>
    <td class="act c-act">{{template "pg-cluster-act" .}}</td></tr>
  {{else}}<tr class="pg-fnone"><td colspan="6"><div class="empty">No cluster in realm <b class="mono">{{.Name}}</b> yet. {{template "pg-action" .NewCluster}}</div></td></tr>{{end}}
  </tbody>{{else}}<tbody><tr class="pg-fnone"><td colspan="6"><div class="empty">{{if .State}}No cluster matches the chip. <a href="{{(index .Chips 0).URL}}">Show all</a>{{else}}No cluster{{with .Realm}} in realm <b class="mono">{{.}}</b>{{end}} yet.{{end}}</div></td></tr></tbody>{{end}}
  </table></div>
  {{if .Shown}}<div class="pg-key">{{template "pg-legend" .AnyLife}}</div>{{end}}</section>
{{end}}{{end}}{{end}}

{{define "pg-first-steps"}}<section class="panel"><div class="ph"><h2>No realm on this Docker daemon yet</h2></div><div class="pb"><ol class="pg-steps">
  <li><div><b>Check the host</b><div class="muted">Doctor checks Docker and cgroup v2.</div></div><a class="btn sm" href="/doctor">Doctor</a></li>
  <li><div><b>Create a cluster</b><div class="muted">A controller and two workers, in about 30 s.</div></div>{{range .Actions}}{{if eq .Class "primary"}}{{template "pg-action" .}}{{end}}{{end}}</li>
  <li><div><b>Run a job</b><div class="muted">Enter the cluster and submit a test job.</div></div><span class="faint">after step 2</span></li>
  <li><div><b>Delete it</b><div class="muted">sind removes the containers, networks and volumes.</div></div><span class="faint">when done</span></li></ol></div></section>{{end}}

{{/* pg-overview-needs comes first on the page, so it shows only when
something needs the user or runs; the head says when nothing does. "Needs
you" has a row for each problem, with the action that most likely fixes it
in a column of its own, and a row that a command fixed turns green until
run.js hides it at data-hide-at, and recounts the head (data-needs-*). The
strip "Running now" at its end lists the commands that run, which are no
problem; when nothing needs the user, it is the panel alone. */}}
{{define "pg-overview-needs"}}{{with .Data}}{{if or .Needs .Running}}<section class="panel pg-attn pg-block{{if not .Needs}} pg-now-only{{end}}" id="needs" tabindex="-1" aria-labelledby="pg-needs-h"{{if .Needs}} data-needs{{end}}>
  {{if .Needs}}<div class="ph"><h2 id="pg-needs-h">Needs you</h2><span class="grow"></span><span class="faint" data-needs-count data-needs-open="{{.OpenCount}}">{{.NeedsText}}</span></div>
  {{range .Needs}}{{$n := .}}<div class="pg-it {{.Sev}}" id="{{.ID}}"{{if .HideAt}} data-hide-at="{{.HideAt}}" data-needs-fixed{{end}}><span class="pg-bar {{.Sev}}"></span><span class="pg-kind">{{.Label}}</span>
    <div class="pg-body"><div class="pg-tt"><b class="mono">{{.Subject}}</b> {{.Title}}{{with .Meta}} <span class="chip" title="realm">{{.}}</span>{{end}}</div><div class="pg-dd">{{.Detail}}{{with .Effect}} <b class="pg-eff">{{.}}</b>{{end}}</div></div>
    <div class="pg-bb">{{range .Actions}}{{template "pg-action" .}}{{end}}</div>
    <div class="pg-dis">{{with .Dismiss}}<form class="inline" method="post" action="/needs/runs/{{.}}/dismiss" hx-post="/needs/runs/{{.}}/dismiss" hx-swap="none">{{template "csrf-field" $}}<button type="submit" class="iconbtn" aria-label="Dismiss: {{$n.Subject}} {{$n.Title}}" title="Dismiss">×</button></form>{{end}}</div>
    <div class="pg-fixc">{{with .Fix}}{{template "pg-action" .}}{{end}}</div></div>
  {{end}}{{else}}<h2 class="vh" id="pg-needs-h">Running now</h2>{{end}}
  {{with .Running}}<div class="pg-now" role="group" aria-label="Running now">{{range $i, $r := .}}<div class="pg-now-r"><span class="pg-now-h">{{if not $i}}Running now{{end}}</span>{{if .Waiting}}<span class="pg-ck wait" aria-hidden="true">○</span>{{else}}<span class="spin" aria-hidden="true"></span>{{end}}<a class="mono pg-now-t" href="{{.Link}}">{{.Title}}</a>{{if .Terminal}}<span class="chip">terminal</span>{{end}}<span class="pg-now-l">{{.Line}}{{with .Lock}} · {{.}}{{end}}</span>{{template "run-elapsed" .}}<a class="btn sm" href="{{.Link}}" aria-label="Show progress: {{.Title}}">Show progress</a></div>
  {{end}}{{if gt (len .) 1}}<div class="pg-now-r pg-now-all"><span class="pg-now-h"></span><a href="{{$.Data.RunningLink}}">Show them in Activity</a></div>{{end}}</div>{{end}}
</section>{{end}}{{end}}{{end}}

{{define "pg-overview-recent"}}{{with .Data}}<section class="panel"><div class="ph"><h2>Recent activity</h2><span class="grow"></span><a href="/activity">All activity</a></div>
  <div class="pg-recent">{{range .Runs}}<a class="pg-r" href="{{.Link}}"><span class="dot {{.Class}}"></span><span class="pg-c">{{.Title}}</span>{{if .Terminal}}<span class="chip">terminal</span>{{end}}<span class="pg-tm">{{.Time}}</span></a>
  {{else}}<div class="empty">No runs yet. Every command that changes something shows here, from this page or from a terminal.</div>{{end}}</div></section>{{end}}{{end}}
