{{/* slot-help is the help button in the top bar, and the markup of the help
pane, which help.js copies into #layer when the pane opens. The pane is a
dialog that does not block the page; help-status says what it loaded, as
the body itself is not a live region. */}}
{{define "slot-help"}}<button type="button" class="iconbtn" data-help-toggle aria-label="Help" title="Help (?)" aria-expanded="false" aria-keyshortcuts="?">?</button>
<template id="help-shell"><aside class="helppane" id="helppane" role="dialog" aria-modal="false" aria-labelledby="help-crumb">
  <div class="hh"><button type="button" class="iconbtn" data-help-back aria-label="Back" title="Back" hidden>←</button><span class="crumb" id="help-crumb">Help</span><button type="button" class="iconbtn" data-help-close aria-label="Close help" title="Close (Esc)">×</button></div>
  <div class="hs"><input type="search" id="help-q" placeholder="Search help: realm, sbatch, clean up…" aria-label="Search help" autocomplete="off" spellcheck="false"></div>
  <div class="hb" id="help-body" tabindex="-1"></div>
  <div class="vh" id="help-status" role="status"></div>
</aside></template>{{end}}
