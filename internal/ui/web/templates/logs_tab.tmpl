{{/* logs-units lists the units of a node of the role it gets: its Slurm
service first. It uses nothing but builtins, so that the part needs no
template function. */}}
{{define "logs-units"}}{{if eq . "controller"}}slurmctld {{else if eq . "db"}}mariadb slurmdbd {{else if eq . "api"}}slurmrestd {{else if eq . "worker"}}slurmd {{end}}munge sshd{{end}}

{{/* logs-tab is the body of the Logs tab of the cluster page. It needs the
view of that page (Params realm and cluster, and node to preselect one) and
logs.js, which opens the stream GET /logs/{realm}/{cluster}. */}}
{{define "logs-tab"}}
{{$realm := .Params.Get "realm"}}{{$cl := .Params.Get "cluster"}}{{$sel := .Params.Get "node"}}
{{$prefix := printf "%s-%s-" $realm $cl}}
{{$nodes := index .Snap.Nodes $realm}}
{{$cmd := "sind logs "}}{{if ne $realm "sind"}}{{$cmd = printf "sind --realm %s logs " $realm}}{{end}}
{{$first := ""}}{{$found := false}}
{{range $nodes}}{{if and (eq .Cluster $cl) (ge (len .Container) (len $prefix))}}{{$short := slice .Container (len $prefix)}}{{if eq $first ""}}{{$first = $short}}{{end}}{{if eq $short $sel}}{{$found = true}}{{end}}{{end}}{{end}}
{{if not $found}}{{$sel = $first}}{{end}}
{{if $first}}
<section class="panel logs" id="logs-panel" data-logs data-realm="{{$realm}}" data-cluster="{{$cl}}" data-cmd-prefix="{{$cmd}}">
  <div class="ph logs-bar">
    <div class="fld logs-fld"><label for="logs-node">Node</label>
      <select id="logs-node" data-logs-node>
        {{range $nodes}}{{if and (eq .Cluster $cl) (ge (len .Container) (len $prefix))}}{{$short := slice .Container (len $prefix)}}<option value="{{$short}}" data-units="{{template "logs-units" (print .Role)}}"{{if eq $short $sel}} selected{{end}}>{{$short}}{{if ne (print .State) "running"}} ({{.State}}){{end}}</option>
        {{end}}{{end}}
      </select></div>
    <div class="fld logs-fld"><label for="logs-source">Source</label>
      <select id="logs-source" data-logs-source>
        <option value="docker">container (docker logs)</option>
        <option value="journal">journal, all units</option>
      </select></div>
    <div class="fld logs-fld" data-logs-unit-fld hidden><label for="logs-unit">Unit</label>
      <select id="logs-unit" data-logs-unit></select></div>
    <span class="grow"></span>
    <div class="seg" role="group" aria-label="Follow">
      <button type="button" class="on" data-logs-follow aria-pressed="true">Follow</button>
      <button type="button" data-logs-pause aria-pressed="false">Pause</button>
    </div>
    <button type="button" class="btn sm" data-logs-clear>Clear</button>
  </div>
  <div class="pb stack">
    <div><p class="cmdlabel">The same in a terminal</p>
      <div class="cmd"><code data-logs-cmd>{{$cmd}}{{$sel}}.{{$cl}} -f -n 200</code><button type="button" data-logs-copy>Copy</button></div></div>
    <pre class="term logbox" data-logs-box tabindex="0" aria-label="Log lines" aria-live="off"></pre>
    <div class="logs-foot"><span class="hint faint" data-logs-state>Connecting…</span>
      <span class="hint faint">Starts with the last 200 lines and keeps the last 2,000. The stream stops when you leave the tab.</span></div>
  </div>
</section>
{{else}}
<section class="panel"><div class="empty">No nodes of {{$cl}} are known yet, so there is no log to show.</div></section>
{{end}}
{{end}}
