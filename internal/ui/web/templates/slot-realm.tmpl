{{/* slot-realm is the realm picker in the top bar. It shows the realm of the
page and goes to ?realm= of the page itself when the page shows one realm or
all of them, or else to the list of clusters or nodes. pg.js applies a pick
of the mouse at once, and one of the keyboard on Enter or when the focus
leaves, so that the arrow keys browse the list. Without script, the button
applies it. */}}
{{define "slot-realm"}}<form class="realm" method="get" action="{{.PgRealmNext}}" autocomplete="off" data-pg-realm><label for="realm-sel">realm</label><select id="realm-sel" name="realm" aria-label="Realm" aria-describedby="realm-hint">{{range .PgRealmOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select><noscript><button type="submit" class="btn sm">Show</button></noscript><span class="pg-vh" id="realm-hint" role="status" data-pg-realm-hint></span></form>{{end}}
