{{/* page-more-monitoring is the Monitoring page. */}}
{{define "page-more-monitoring"}}
<div class="head"><div class="t"><h1>Monitoring</h1>
  <div class="sub">{{template "pg-realm-scope" .}}<span>One stack per realm. It collects Slurm metrics, the nodes' resource use and their journals. This page shows the key numbers; Grafana has the rest.</span></div></div>
  <div class="more-iv">{{fragment "more-mon-interval" .}}</div></div>
<div class="stack" id="more-monitoring" hx-swap="morph:innerHTML" sse-swap="more-monitoring">{{fragment "more-monitoring" .}}</div>
{{end}}

{{/* more-mon-interval picks how often sind ui reads the stacks while a page
is open; .Data is moreIntervalData, nil when nothing reads them. Each
button saves its interval. After a save, the answer is the form, which
replaces the old one, and the words inside the status beside it, which
stays, so that a screen reader reads the change. The buttons have ids,
so that htmx gives the focus back to the one pressed. It is no live
fragment, so that an update never takes the focus. */}}
{{define "more-mon-interval"}}{{with .Data}}<form class="more-ivform" method="post" action="/monitoring/interval" hx-post="/monitoring/interval" hx-swap="outerHTML">{{template "csrf-field" $}}
  <span id="mon-interval-label">Read every</span>
  <span class="seg" role="group" aria-labelledby="mon-interval-label">{{range .Choices}}<button type="submit" id="mon-interval-{{.Value}}" name="interval" value="{{.Value}}" aria-pressed="{{.Selected}}">{{.Value}}</button>{{end}}</span>
</form>{{if .Saved}}<span id="mon-saved" hx-swap-oob="true">Saved: every {{.Saved}}</span>{{else}}<span class="more-saved" role="status"><span id="mon-saved"></span></span>
<p class="more-ivnote">How often sind ui reads the stacks and their numbers while a page is open. The choice lasts until sind ui stops. Prometheus keeps its own scrape interval.</p>{{end}}{{end}}{{end}}

{{/* more-mon-dns says what the Open links need: a host that resolves the
names under .sind. .Data is moreMonitoringData. */}}
{{define "more-mon-dns"}}{{$fwd := .Forward}}
{{if eq .HostDNS "off"}}<div class="callout warn">This host does not resolve the names under <span class="mono">.sind</span> (<a href="/doctor">Doctor: DNS policy</a>), so the Open links fail. Use the address with its port instead.{{template "more-mon-forward" $fwd}}</div>
{{else if eq .HostDNS "ok"}}<p class="muted more-note">Open uses the names under <span class="mono">.sind</span>, which this host resolves.{{template "more-mon-forward" $fwd}}</p>
{{else}}<p class="muted more-note">Open uses the names under <span class="mono">.sind</span>, which resolve only on the Docker host, with host DNS. If Open fails, use the address with its port.{{template "more-mon-forward" $fwd}}</p>{{end}}
{{end}}

{{/* more-mon-forward says how to reach Grafana from another machine; . is
its address with the port, "" for none. */}}
{{define "more-mon-forward"}}{{with .}} To open Grafana from another machine, forward its address with <code class="mono">ssh -L 3000:{{.}} HOST</code>, then open <span class="mono">http://localhost:3000</span>.{{end}}{{end}}

{{/* more-monitoring is the live body of the page; .Data is moreMonitoringData. */}}
{{define "more-monitoring"}}{{with .Data}}
{{template "more-dockerdown" .DockerErr}}
{{if .Notice.Text}}{{template "more-notice" .Notice}}{{end}}
{{if .Empty}}
<section class="panel"><div class="empty">
  <p>{{if .Realm}}Realm <b class="mono">{{.Realm}}</b> has{{else}}No realm has{{end}} no monitoring stack.</p>
  <p>Create a cluster with Monitoring on, and sind starts Prometheus, Loki, Grafana and Alloy for the realm. It needs Slurm 26.05.</p>
  <div class="more-howto">
    <p class="cmdlabel">From your terminal</p>
    <div class="cmd"><code>sind create cluster --monitoring</code><button type="button" data-more-copy aria-label="Copy sind create cluster --monitoring">Copy</button></div>
  </div>
  <p><a class="btn primary" href="{{.NewURL}}" hx-get="{{.NewURL}}" hx-target="#layer" hx-swap="innerHTML">New cluster…</a></p>
</div></section>
{{end}}
{{range .Realms}}{{$realm := .Name}}
<div class="stack more-realm">
  <div class="more-rhead">
    <h2>{{if $.Data.Multi}}Realm <b class="mono">{{.Name}}</b>{{else}}Stack{{end}}</h2>
    <span class="grow"></span><span class="faint">{{len .Services}} services</span>
  </div>
  <section class="panel"><div class="ph"><h2>Monitored clusters</h2><span class="grow"></span><span class="faint">Slurm numbers from Prometheus</span></div>
    {{if .Clusters}}<div class="tw"><table class="more-cards more-moncards" role="table"><thead role="rowgroup"><tr role="row"><th role="columnheader">Cluster</th><th role="columnheader" class="num">Nodes running</th><th role="columnheader" class="num">Slurm nodes up</th><th role="columnheader" class="num">Jobs running</th><th role="columnheader" class="num">Jobs pending</th><th role="columnheader">Slurm</th></tr></thead><tbody role="rowgroup">
      {{range .Clusters}}<tr role="row"><td role="cell"><a href="/clusters/{{$realm}}/{{.Name}}"><b>{{.Name}}</b></a></td>
        <td role="cell" class="num" data-label="Nodes running">{{.Running}} of {{.Total}}</td>
        {{if .Slurm}}<td role="cell" class="num" data-label="Slurm nodes up">{{.Up}} of {{.Slurm.Nodes}}{{if or .Slurm.NodesDown .Slurm.NodesDrain}}<br><span class="faint more-nowrap">{{.Slurm.NodesDown}} down, {{.Slurm.NodesDrain}} draining</span>{{end}}</td>
        <td role="cell" class="num" data-label="Jobs running">{{.Slurm.JobsRunning}}</td><td role="cell" class="num" data-label="Jobs pending">{{.Slurm.JobsPending}}</td>
        {{else}}<td role="cell" colspan="3" class="faint more-nonum">No numbers yet: Prometheus has them once it has read slurmctld.</td>{{end}}
        <td role="cell" class="mono more-aside">{{.SlurmVersion}}</td></tr>{{end}}
    </tbody></table></div>
    {{else}}<div class="empty">No cluster of this realm is monitored.</div>{{end}}</section>
  <section class="panel"><div class="ph"><h2>Services</h2></div><div class="tw"><table class="more-cards" role="table"><thead role="rowgroup"><tr role="row"><th role="columnheader">Service</th><th role="columnheader">State</th><th role="columnheader">Address</th><th role="columnheader">Image</th><th role="columnheader"><span class="more-vh">Open</span></th></tr></thead><tbody role="rowgroup">
    {{range .Services}}<tr role="row"><td role="cell"><b>{{.Name}}</b><br><span class="mono faint">{{.Container}}</span></td>
      <td role="cell"><span class="pill{{with .Pill}} {{.}}{{end}}">{{.Text}}</span></td>
      <td role="cell" class="more-long" data-label="Address"><span class="mono">{{.URL}}</span>{{if .Addr}}<br><span class="more-addr"><span class="mono faint">{{.Addr}}</span> <button type="button" class="btn sm" data-more-copy-text="{{.Addr}}" aria-label="Copy the address of {{.Name}}">Copy</button></span>{{end}}</td>
      <td role="cell" class="mono faint more-long" data-label="Image">{{.Image}}</td>
      <td role="cell" class="act">{{if .Open}}<a class="btn sm" href="{{.URL}}" target="_blank" rel="noopener noreferrer" aria-label="Open {{.Name}} in a new tab">Open ↗</a>{{end}}</td></tr>
    {{end}}</tbody></table></div>
    <div class="pb more-dns">{{template "more-mon-dns" $.Data}}</div></section>
</div>
{{end}}
{{if and .Realms .Without}}<p class="muted">No stack in {{range $i, $r := .Without}}{{if $i}}, {{end}}<span class="mono">{{$r}}</span>{{end}}.</p>{{end}}
{{end}}{{end}}
