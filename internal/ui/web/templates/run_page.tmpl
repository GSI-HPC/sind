{{/* page-run is the run page: one command of the event log, drawn as the
header, the summary, what failed, the timeline of its steps, a tile for each
node, the transfers and the steps without targets, and the raw facts. Each
part is a fragment that /events sends again when the run changes. */}}
{{define "page-run"}}
<div class="crumbs"><a href="/activity">Activity</a> / <span class="mono">{{.Params.Get "id"}}</span></div>
<div class="rp">
<div hx-swap="morph:innerHTML" sse-swap="run-head">{{fragment "run-head" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="run-summary">{{fragment "run-summary" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="run-failed">{{fragment "run-failed" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="run-timeline">{{fragment "run-timeline" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="run-nodes">{{fragment "run-nodes" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="run-more">{{fragment "run-more" .}}</div>
<div hx-swap="morph:innerHTML" sse-swap="run-facts">{{fragment "run-facts" .}}</div>
</div>
{{end}}

{{define "run-head"}}{{with .Data}}{{if .Gone}}<div class="callout warn">This run is gone: sind ui keeps the newest runs of the event log only. <a href="/activity">Back to Activity</a></div>
{{else}}<div class="head runhead"><div class="t"><h1>{{.Title}}</h1>
  <div class="sub"><span class="pill {{.PillClass}}">{{.Pill}}</span>{{with .Realm}}<span class="chip" title="realm">{{.}}</span>{{end}}<span>{{.Origin}}</span>{{if .Program}}<span>{{.Program}}</span>{{end}}<span>started {{.Started}}</span>{{if .Exit}}<span class="mono">{{.Exit}}</span>{{end}}<span class="mono faint" title="trace {{.TraceTip}}"><span data-word="trace">trace</span> {{.Trace}}</span></div></div>
  <div class="actions">{{if .TaskID}}{{if .Canceling}}<button type="button" class="btn" disabled>Stopping…</button>{{else}}{{with .Stop}}{{template "run-stop" .}}{{end}}{{end}}{{end}}{{template "run-retry" .}}</div></div>
{{with .NoStop}}<div class="callout">{{.}}</div>{{end}}
{{with .Command}}<div class="runcmd">{{template "pg-cmd" .}}{{with $.Data.CmdNote}}<p class="hint">{{.}}</p>{{end}}{{with $.Data.Config}}<details class="runcfg"><summary>Config used</summary><div class="runcfg-path mono">{{.Label}}</div><pre class="mono">{{.Text}}</pre></details>{{end}}</div>{{end}}
{{end}}{{end}}{{end}}

{{define "run-summary"}}{{with .Data}}<section class="panel"><div class="pb">
  <div class="rsum"><span class="clock">{{template "run-elapsed" .}}</span>
    <div class="rbar">{{template "run-segbar" .}}<div class="mono rline">{{.Line}}</div></div>
    <div class="counts">{{if .NoTargets}}<span class="faint">no targets</span>{{else}}{{range .Counts}}<span><i class="dot {{.Class}}"></i>{{.N}} {{.Label}}</span>{{end}}{{end}}</div></div>
  {{range .Hints}}<div class="hint">{{.}}</div>{{end}}
  <span hidden data-doc-title="{{.DocTitle}}"></span><span hidden data-say-key="{{.SayKey}}" data-say-state="{{.SayState}}" data-say="{{.Say}}"{{if .SaySince}} data-say-since="{{.SaySince}}"{{end}}></span>
</div></section>{{end}}{{end}}

{{define "run-failed"}}{{with .Data}}<section class="panel rfail {{.Class}}"><div class="ph"><h2>{{.Title}}</h2></div><div class="pb stack">
  {{range .Groups}}<div class="callout {{$.Data.Class}}"><b class="mono">{{.Nodes}}</b>{{if .Class}} <span class="chip">{{.Class}}</span>{{end}}<br><span class="mono">{{.Err}}</span></div>{{end}}
  {{if .CmdErr}}<div class="callout bad"><span class="mono">{{.CmdErr}}</span></div>{{end}}
  {{range .Notes}}<div class="hint">{{.}}</div>{{end}}
  {{if .Doctor}}<div class="hint">A timeout often means that a node needed more time: try again with a longer <span class="mono">--wait</span>, or check the host in <a href="/doctor">Doctor</a>.</div>{{end}}
</div></section>{{end}}{{end}}

{{define "run-timeline"}}{{with .Data}}<section class="panel"><div class="ph"><h2>Steps</h2><span class="grow"></span><span class="faint">Open a step for its targets. Steps that overlap ran at the same time.</span></div><div class="pb gantt">
<div class="axis"><span></span><span class="ticks">{{range .Ticks}}<span class="l{{.Pos}}{{if .Minor}} minor{{end}}">{{.Label}}</span>{{end}}</span><span></span></div>
{{range .Rows}}{{template "run-row" .}}{{else}}<div class="faint">No steps yet.</div>{{end}}
</div></section>{{end}}{{end}}

{{define "run-rowcells"}}<span class="lbl" title="{{.Name}}"><span class="mark {{.Class}}">{{.Mark}}</span>{{.Name}}{{if .Total}} <span class="faint">{{.Total}}</span>{{end}}</span><span class="trk">{{if .Bar}}<span class="bar {{.Class}} l{{.Left}} w{{.Width}}"></span>{{end}}</span><span class="res">{{.Result}}</span>{{end}}

{{define "run-row"}}{{if .Children}}<details class="grow-details" id="step-{{.ID}}"><summary class="grow-row">{{template "run-rowcells" .}}</summary>{{range .Children}}{{template "run-row" .}}{{end}}</details>{{else}}<div class="grow-row">{{template "run-rowcells" .}}</div>{{end}}{{end}}

{{define "run-nodes"}}{{with .Data}}<section class="panel"><div class="ph"><h2>Nodes</h2><span class="grow"></span><span class="faint">Each node goes from left to right. The ring is the part of the wait limit it used.</span></div><div class="pb nodegrid">
{{range .Tiles}}<div class="ntile {{.RoleClass}} {{.Class}}"><div class="nt"><span class="mark {{.Class}}">{{.Mark}}</span><b>{{.Name}}</b>{{if .Role}}<small>{{.Role}}</small>{{end}}</div>
  <div class="pipe">{{range .Pipe}}<i class="{{.Class}}" title="{{.Title}}"></i>{{end}}</div>
  <div class="pipelbl">{{range .Pipe}}<span>{{.Label}}</span>{{end}}</div>
  <div class="msg"><span title="{{.Msg}}">{{.Msg}}</span>{{with .Ring}}<svg class="ring" viewBox="0 0 28 28" role="img" aria-label="{{.Title}} of the wait limit"><circle class="rtrack" cx="14" cy="14" r="11" fill="none" stroke-width="4"/><circle class="rarc {{.Class}}" cx="14" cy="14" r="11" fill="none" stroke-width="4" stroke-dasharray="{{.Dash}}" transform="rotate(-90 14 14)"/></svg>{{end}}</div></div>
{{end}}</div></section>{{end}}{{end}}

{{define "run-more"}}{{with .Data}}<div class="grid g2">
{{if .Transfers}}<section class="panel"><div class="ph"><h2>Transfers</h2><span class="grow"></span><span class="faint">work done of work to do, from the advance events</span></div><div class="pb">
{{range .Transfers}}<div class="pullrow"><span class="pn"><span class="mark {{.Class}}">{{.Mark}}</span>{{.Name}}</span><span class="num amt">{{.Amount}}</span>{{if .Bar}}<div class="meter"><i class="{{.Class}} w{{.Pct}}"></i></div>{{end}}{{if .Msg}}<span class="ln">{{.Msg}}</span>{{end}}</div>
{{end}}</div></section>{{end}}
{{if .Steps}}<section class="panel"><div class="ph"><h2>Other steps</h2></div><div class="pb"><dl class="kv">
{{range .Steps}}<dt class="mono">{{.Name}}</dt><dd><span class="pill {{.PillClass}} nodot">{{.Class}}</span>{{if .Text}}<span class="muted">{{.Text}}</span>{{end}}</dd>
{{end}}</dl></div></section>{{end}}
</div>{{end}}{{end}}

{{define "run-facts"}}{{with .Data}}<section class="panel"><details class="raw" id="run-facts-raw"><summary>What the event log says about this run</summary><div class="pb"><dl class="kv">
{{range .Facts}}<dt>{{.Key}}</dt><dd{{if .Mono}} class="mono"{{end}}>{{.Val}}</dd>
{{end}}</dl></div></details></section>{{end}}{{end}}

{{/* run-retry are the buttons of a run of sind ui that ended, from a runHead
or a runWait: Try again, which runs the same command again (actRetryRoute),
the dialog filled in with the task's form, and the way back to what the
command worked on. */}}
{{define "run-retry"}}{{if .RetryID}}<form class="inline" method="post" action="/tasks/{{.RetryID}}/retry" hx-post="/tasks/{{.RetryID}}/retry" hx-swap="none">{{template "csrf-field" .}}<button type="submit" class="btn primary">Try again</button></form>{{end}}{{with .Edit}}<a class="btn" href="{{.Href}}" hx-get="{{.Href}}" hx-target="#layer" hx-swap="innerHTML">{{.Label}}</a>{{end}}{{with .Back}}<a class="btn" href="{{.Href}}">{{.Label}}</a>{{end}}{{end}}
