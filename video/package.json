{
  "name": "sind-video",
  "private": true,
  "description": "Sindy: AI-presented tutorial videos for sind, rendered with HyperFrames",
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "episode": "node tools/episode.mjs",
    "vendor": "node tools/sync-vendor.mjs",
    "voice:setup": "python3 voice/sindy_voice.py setup",
    "voice:samples": "python3 voice/sindy_voice.py samples -o renders/voice-samples",
    "sheet": "node tools/shot.mjs sindy/sheet.html sindy/sheet.png mode=expr"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.1",
    "hyperframes": "0.9.38",
    "puppeteer-core": "^25.17.0"
  },
  "overrides": {
    "undici": "^7.30.2"
  }
}
