// Generated by sind for realm "sind" from its node containers that mount sind-journal.
// sind rewrites this file and reloads Alloy; do not edit.

prometheus.remote_write "local" {
  endpoint {
    url = "http://sind-prometheus:9090/api/v1/write"
  }
  external_labels = { "realm" = "sind" }
}

prometheus.scrape "slurm_jobs" {
  targets = [
    { "__address__" = "sind-dev-controller:6817", "cluster" = "dev", "node" = "controller", "role" = "controller" },
  ]
  job_name         = "slurm_jobs"
  metrics_path     = "/metrics/jobs"
  scrape_interval  = "30s"
  follow_redirects = false
  forward_to       = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "slurm_nodes" {
  targets = [
    { "__address__" = "sind-dev-controller:6817", "cluster" = "dev", "node" = "controller", "role" = "controller" },
  ]
  job_name         = "slurm_nodes"
  metrics_path     = "/metrics/nodes"
  scrape_interval  = "30s"
  follow_redirects = false
  forward_to       = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "slurm_partitions" {
  targets = [
    { "__address__" = "sind-dev-controller:6817", "cluster" = "dev", "node" = "controller", "role" = "controller" },
  ]
  job_name         = "slurm_partitions"
  metrics_path     = "/metrics/partitions"
  scrape_interval  = "30s"
  follow_redirects = false
  forward_to       = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "slurm_scheduler" {
  targets = [
    { "__address__" = "sind-dev-controller:6817", "cluster" = "dev", "node" = "controller", "role" = "controller" },
  ]
  job_name         = "slurm_scheduler"
  metrics_path     = "/metrics/scheduler"
  scrape_interval  = "30s"
  follow_redirects = false
  forward_to       = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "slurm_users" {
  targets = [
    { "__address__" = "sind-dev-controller:6817", "cluster" = "dev", "node" = "controller", "role" = "controller" },
  ]
  job_name         = "slurm_users"
  metrics_path     = "/metrics/jobs-users-accts"
  scrape_interval  = "60s"
  follow_redirects = false
  forward_to       = [prometheus.remote_write.local.receiver]
}

prometheus.exporter.blackbox "slurm" {
  config = "{ modules: { http: { prober: http, timeout: 5s }, tcp: { prober: tcp, timeout: 5s } } }"
  target {
    name    = "n_dev__controller_slurmctld_live"
    address = "http://sind-dev-controller:6817/livez"
    module  = "http"
    labels  = { "cluster" = "dev", "node" = "controller", "role" = "controller", "service" = "slurmctld", "check" = "live" }
  }
  target {
    name    = "n_dev__controller_slurmctld_ready"
    address = "http://sind-dev-controller:6817/readyz"
    module  = "http"
    labels  = { "cluster" = "dev", "node" = "controller", "role" = "controller", "service" = "slurmctld", "check" = "ready" }
  }
  target {
    name    = "n_dev__db_slurmdbd_tcp"
    address = "sind-dev-db:6819"
    module  = "tcp"
    labels  = { "cluster" = "dev", "node" = "db", "role" = "db", "service" = "slurmdbd", "check" = "tcp" }
  }
  target {
    name    = "n_dev__worker_0_slurmd_ready"
    address = "http://sind-dev-worker-0:6818/readyz"
    module  = "http"
    labels  = { "cluster" = "dev", "node" = "worker-0", "role" = "worker", "service" = "slurmd", "check" = "ready" }
  }
}

prometheus.scrape "slurm_health" {
  targets         = prometheus.exporter.blackbox.slurm.targets
  job_name        = "slurm_health"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.exporter.cadvisor "nodes" {
  docker_only = false
  raw_cgroup_prefix_allowlist = [
    "/system.slice/docker-eeee.scope", // sind-2nd-submitter
    "/system.slice/docker-aaaa.scope", // sind-dev-controller
    "/system.slice/docker-cccc.scope", // sind-dev-db
    "/system.slice/docker-bbbb.scope", // sind-dev-worker-0
    "/system.slice/docker-dddd.scope", // sind-dev-worker-1
  ]
  store_container_labels = false
}

prometheus.scrape "cgroups" {
  targets         = prometheus.exporter.cadvisor.nodes.targets
  job_name        = "cgroups"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.nodes.receiver]
}

prometheus.relabel "nodes" {
  forward_to = [prometheus.remote_write.local.receiver]
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-eeee\\.scope(/.*)?"
    target_label  = "cluster"
    replacement   = "2nd"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-eeee\\.scope(/.*)?"
    target_label  = "node"
    replacement   = "submitter"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-eeee\\.scope(/.*)?"
    target_label  = "role"
    replacement   = "submitter"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-aaaa\\.scope(/.*)?"
    target_label  = "cluster"
    replacement   = "dev"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-aaaa\\.scope(/.*)?"
    target_label  = "node"
    replacement   = "controller"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-aaaa\\.scope(/.*)?"
    target_label  = "role"
    replacement   = "controller"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-cccc\\.scope(/.*)?"
    target_label  = "cluster"
    replacement   = "dev"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-cccc\\.scope(/.*)?"
    target_label  = "node"
    replacement   = "db"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-cccc\\.scope(/.*)?"
    target_label  = "role"
    replacement   = "db"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-bbbb\\.scope(/.*)?"
    target_label  = "cluster"
    replacement   = "dev"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-bbbb\\.scope(/.*)?"
    target_label  = "node"
    replacement   = "worker-0"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-bbbb\\.scope(/.*)?"
    target_label  = "role"
    replacement   = "worker"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-dddd\\.scope(/.*)?"
    target_label  = "cluster"
    replacement   = "dev"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-dddd\\.scope(/.*)?"
    target_label  = "node"
    replacement   = "worker-1"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice/docker-dddd\\.scope(/.*)?"
    target_label  = "role"
    replacement   = "worker"
  }
  rule {
    source_labels = ["id"]
    regex         = "/(?:system\\.slice/docker-[0-9a-f]+\\.scope|docker/[0-9a-f]+)(/.*)?"
    target_label  = "cgroup"
    replacement   = "$1"
  }
  rule {
    source_labels = ["cgroup"]
    regex         = ".*/job_([0-9]+)(/.*)?"
    target_label  = "job_id"
    replacement   = "$1"
  }
  rule {
    source_labels = ["cgroup"]
    regex         = ".*/([^/]+\\.service)"
    target_label  = "unit"
    replacement   = "$1"
  }
  rule {
    source_labels = ["node"]
    regex         = ""
    action        = "drop"
  }
}

loki.source.journal "n_2nd__submitter" {
  path          = "/var/log/sind/2nd/submitter"
  labels        = { "realm" = "sind", "cluster" = "2nd", "node" = "submitter", "role" = "submitter" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.levels.receiver]
}

loki.source.journal "n_dev__controller" {
  path          = "/var/log/sind/dev/controller"
  labels        = { "realm" = "sind", "cluster" = "dev", "node" = "controller", "role" = "controller" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.levels.receiver]
}

loki.source.journal "n_dev__db" {
  path          = "/var/log/sind/dev/db"
  labels        = { "realm" = "sind", "cluster" = "dev", "node" = "db", "role" = "db" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.levels.receiver]
}

loki.source.journal "n_dev__worker_0" {
  path          = "/var/log/sind/dev/worker-0"
  labels        = { "realm" = "sind", "cluster" = "dev", "node" = "worker-0", "role" = "worker" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.levels.receiver]
}

loki.source.journal "n_dev__worker_1" {
  path          = "/var/log/sind/dev/worker-1"
  labels        = { "realm" = "sind", "cluster" = "dev", "node" = "worker-1", "role" = "worker" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.levels.receiver]
}

loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)"
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_unit"]
    regex         = "(.+)"
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "(.+)"
    target_label  = "level"
  }
}

loki.process "levels" {
  forward_to = [loki.write.local.receiver]
  stage.match {
    selector = "{unit=~\"(slurmctld|slurmd|slurmdbd|sackd|slurmrestd)[.]service\"} |~ \"^(?:\\\\[[^\\\\]]*\\\\] )?(?:[a-z]+: )?(?P<level>fatal|error|warning|debug)[2-5]?: \""
    stage.regex {
      expression = "^(?:\\[[^\\]]*\\] )?(?:[a-z]+: )?(?P<level>fatal|error|warning|debug)[2-5]?: "
    }
    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"fatal\" }}crit{{ else if eq .Value \"error\" }}err{{ else }}{{ .Value }}{{ end }}"
    }
    stage.labels {
      values = { "level" = "" }
    }
  }
  stage.match {
    selector = "{unit=\"mariadb.service\"} |~ \"\\\\[(?P<level>ERROR|Warning|Note)\\\\]\""
    stage.regex {
      expression = "\\[(?P<level>ERROR|Warning|Note)\\]"
    }
    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"ERROR\" }}err{{ else if eq .Value \"Warning\" }}warning{{ else }}info{{ end }}"
    }
    stage.labels {
      values = { "level" = "" }
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://sind-loki:3100/loki/api/v1/push"
  }
}
